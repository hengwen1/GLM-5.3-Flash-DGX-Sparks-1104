+                continue;
+            } else |e| { // never fatal: the kernel below produces the same matrix
+                std.log.err("glm_mm cuBLASLt {d}x{d}x{d}: {}; the kernel takes it", .{ rows, w.n, w.k, e });
+            }
+        }
