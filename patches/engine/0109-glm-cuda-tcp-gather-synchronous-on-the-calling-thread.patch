+/// The validate round trips' byte at `i`: rank- and salt-dependent, so a stripe that lands in the wrong buffer,
+/// a connection that pairs with another rail's, and a rank that echoes itself all fail the pattern.
+fn patternByte(rank: u32, salt: usize, i: usize) u8 {
+    const v: u32 = 0x5A ^ (rank *% 0x2D) ^ @as(u32, @truncate(salt)) ^ @as(u32, @truncate((i *% 109) >> 3));
+    return @truncate(v);
+}
+
+fn fillPattern(rank: u32, salt: usize, buf: []u8) void {
+    for (buf, 0..) |*b, i| b.* = patternByte(rank, salt, i);
+}
+
+fn patternOk(rank: u32, salt: usize, buf: []const u8) bool {
+    for (buf, 0..) |b, i| if (b != patternByte(rank, salt, i)) return false;
+    return true;
+}
