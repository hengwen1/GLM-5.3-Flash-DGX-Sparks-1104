+    fn postDdpDrain(q: *Queue, scratch_iova: u64, npkts: u32) void {
+        const rx = q.rx_ring.?;
+        for (0..npkts) |_| {
+            const idx = q.rx_prod & uapi.ring_mask;
+            cacheInvalRange(q.rx_buf_va + @as(usize, idx) * q.rx_stride, hdr_bytes + 64);
+            const hiova = q.rx_buf_iova + @as(u64, idx) * q.rx_stride;
+            rx[idx].d0 = @truncate(hiova);
+            rx[idx].d1 = @truncate(hiova >> 32);
+            rx[idx].d2 = @truncate(scratch_iova);
+            dmbOshst();
+            @atomicStore(u32, &rx[idx].d3, (@as(u32, @truncate(scratch_iova >> 32)) & 0xFFFF) | uapi.desc_own, .release);
+            q.rx_prod +%= 1;
+        }
+        const tail = q.rx_prod & uapi.ring_mask;
+        rx[tail].d3 = 0;
+        q.ringRx();
+    }
