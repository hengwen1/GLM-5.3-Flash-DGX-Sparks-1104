+/// TF_GLM_MM_CUBLAS=1: a prompt's dense linears go to cuBLASLt instead of glm_mm's prompt kernel. On a Jetson AGX
+/// Thor that is the 5th-gen tensor core (tcgen05/TMEM), which cuBLAS dispatches and the engine's mma.sync kernels do
+/// not: 5.5x the kernel's time at 512 rows, 2.2x at 128. Off (the default) is the kernels as they were. cuBLAS
+/// accumulates in fp32 in its own order, so the sums are not bit-identical to glm_mm's; the replies differ in the last
+/// bits, which is the trade this switch makes. Decode rows (< TF_GLM_MM_CUBLAS_MIN_ROWS, default 128) stay on the
+/// kernels: 1.6x there is not worth a launch.
+const CublasCfg = struct { on: bool, min_rows: usize };
+var cublas_cfg: ?CublasCfg = null;
+
+fn cublasConfig() CublasCfg {
+    if (cublas_cfg) |c| return c;
+    var c: CublasCfg = .{ .on = false, .min_rows = 128 };
+    if (std.c.getenv("TF_GLM_MM_CUBLAS")) |v| {
+        const t = std.mem.span(v);
+        c.on = !(t.len == 0 or std.mem.eql(u8, t, "0"));
+    }
+    if (std.c.getenv("TF_GLM_MM_CUBLAS_MIN_ROWS")) |v| c.min_rows = @max(128, std.fmt.parseInt(usize, std.mem.span(v), 10) catch 128);
+    cublas_cfg = c;
+    return c;
+}
+
+pub fn cublasEnabled() bool {
+    return cublasConfig().on;
+}
+
+/// One plan a (m, n, k, out type): cuBLASLt's algorithm choice for the shape, kept for the next call.
+const Plan = struct { m: u64, n: u64, k: u64, out_f32: bool, lin: cuda.cublaslt.Linear };
+const max_plans = 512; // a prompt's row counts vary (chunk, tail, batched rows): one plan a shape
+const max_ws = 4; // streams that run prompt matmuls (the main one and a pair's side stream); each its own workspace
+
+/// The cuBLASLt library, a workspace per stream and the plans, opened on the first prompt matmul (TF_GLM_MM_CUBLAS).
+/// Two streams never share a workspace: a paired prompt's chunks run their linears at the same time.
+const Blas = struct {
+    lt: cuda.cublaslt.Library,
+    ws_len: usize,
+    ws_stream: [max_ws]cuda.abi.Stream = undefined,
+    ws: [max_ws]cuda.DeviceBuffer = undefined,
+    n_ws: usize = 0,
+    plans: [max_plans]Plan = undefined,
+    n_plans: usize = 0,
+    lock: std.atomic.Mutex = .unlocked,
+};
+var blas_state: ?Blas = null;
+
+fn blasFor(d: *const cuda.Driver) !*Blas {
+    if (blas_state == null) {
+        const ws_len: usize = 32 << 20;
+        blas_state = .{ .lt = try cuda.cublaslt.Library.open(), .ws_len = ws_len };
+        std.log.info("glm_mm prompt linears: cuBLASLt (TF_GLM_MM_CUBLAS), {d} MiB workspace a stream, from {d} rows", .{ ws_len >> 20, cublasConfig().min_rows });
+    }
+    _ = d;
+    return &blas_state.?;
+}
+
+/// D[rows][n] = X[rows][k] . W[n][k]^T in bf16 with fp32 accumulate, out fp32 (`out_f32`) or bf16.
+fn cublasMm(s: cuda.Stream, x: u64, w: u64, out: u64, rows: usize, n: usize, kk: usize, out_f32: bool) !void {
+    const b = try blasFor(s.d);
+    while (!b.lock.tryLock()) std.Thread.yield() catch {};
+    defer b.lock.unlock();
+    const out_ty: cuda.cublaslt.DataType = if (out_f32) .f32 else .bf16;
+    var ws: ?usize = null;
+    for (b.ws_stream[0..b.n_ws], 0..) |h, i| if (h == s.handle) {
+        ws = i;
+        break;
+    };
+    if (ws == null) {
+        if (b.n_ws == max_ws) return error.TooManyStreams;
+        b.ws[b.n_ws] = try cuda.DeviceBuffer.alloc(s.d, b.ws_len);
+        b.ws_stream[b.n_ws] = s.handle;
+        ws = b.n_ws;
+        b.n_ws += 1;
+    }
+    var plan: ?*Plan = null;
+    for (b.plans[0..b.n_plans]) |*p| {
+        if (p.m == rows and p.n == n and p.k == kk and p.out_f32 == out_f32) {
+            plan = p;
+            break;
+        }
+    }
+    if (plan == null) {
+        if (b.n_plans == max_plans) return error.TooManyPlans;
+        const p = &b.plans[b.n_plans];
+        p.* = .{ .m = rows, .n = n, .k = kk, .out_f32 = out_f32, .lin = try cuda.cublaslt.Linear.init(&b.lt, rows, n, kk, out_ty, b.ws_len) };
+        b.n_plans += 1;
+        plan = p;
+    }
+    try plan.?.lin.run(x, w, out, b.ws[ws.?].ptr, b.ws_len, s.handle);
+}
