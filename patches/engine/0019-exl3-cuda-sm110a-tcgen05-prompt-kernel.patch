+    constexpr int B_BYTES = XR * TBK * 2;                     // 4096 B (XR=64) or 8192 B (XR=128)
+    constexpr int W_WORDS = twords<K2>();                     // 1024 (K2=8) or 768 (K2=6) u32 words
+    constexpr int W_BYTES = W_WORDS * 4;
+    static_assert(2 * A_BYTES + 2 * B_BYTES + 2 * W_BYTES <= tsmem_bytes<K2>(), "tcgen05 smem fits tsmem_bytes");
