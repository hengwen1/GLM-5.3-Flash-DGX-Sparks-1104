+__device__ __forceinline__ uint64_t tcgen05_smem_desc(uint32_t smem_addr, uint32_t lbo_bytes, uint32_t sbo_bytes) {
+    uint64_t d = 0;
+    d |= (uint64_t)((smem_addr & 0x3FFFFu) >> 4);
+    d |= (uint64_t)((lbo_bytes & 0x3FFFFu) >> 4) << 16;
+    d |= (uint64_t)((sbo_bytes & 0x3FFFFu) >> 4) << 32;
+    d |= (uint64_t)1ULL << 46;   // PTX 8.7+ tcgen05 descriptor version bit
+    return d;
