+    asm volatile(
+        "{\n\t"
+        ".reg .pred done;\n\t"
+        "TF_MBAR_WAIT_%=:\n\t"
+        "mbarrier.try_wait.parity.shared::cta.b64 done, [%0], %1, 10000000;\n\t"
+        "@!done bra TF_MBAR_WAIT_%=;\n\t"
+        "}\n"
