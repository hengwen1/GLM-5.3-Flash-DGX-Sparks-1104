+        "tcgen05.mma.cta_group::1.kind::f16 [%0], %1, %2, %3, p0;\n\t"
+        "tcgen05.mma.cta_group::1.kind::f16 [%0], %4, %5, %3, p1;\n\t"
+        "}\n"
