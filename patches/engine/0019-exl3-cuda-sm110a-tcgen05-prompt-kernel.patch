+    const uint64_t da0 = tcgen05_smem_desc(a_base, 128, 512);
+    const uint64_t db0 = tcgen05_smem_desc(b_base, 128, 512);
+    const uint64_t da1 = tcgen05_smem_desc(a_base + 256, 128, 512);
