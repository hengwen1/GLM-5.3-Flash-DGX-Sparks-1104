+    const int chunks = K / TBK;
+    const uint32_t* T0 = reinterpret_cast<const uint32_t*>(tp0[e]);
+    const uint32_t* T1 = reinterpret_cast<const uint32_t*>(tp1[e]);
+
+    uint32_t* A0_u32 = reinterpret_cast<uint32_t*>(smem_raw);
+    uint32_t* A1_u32 = reinterpret_cast<uint32_t*>(smem_raw + A_BYTES);
+    half* B_base = reinterpret_cast<half*>(smem_raw + 2 * A_BYTES);
+    uint32_t* W_base = reinterpret_cast<uint32_t*>(smem_raw + 2 * A_BYTES + 2 * B_BYTES);
+
+    const uint32_t a0_smem = (uint32_t)__cvta_generic_to_shared(A0_u32);
+    const uint32_t a1_smem = (uint32_t)__cvta_generic_to_shared(A1_u32);
+    const uint32_t b0_smem = (uint32_t)__cvta_generic_to_shared(B_base);
+    const uint32_t b1_smem = b0_smem + (uint32_t)B_BYTES;
+
+    __shared__ __align__(8) uint64_t mbar[2];
+    if (tid == 0) {
+        tcgen05_mbar_init(&mbar[0], 1);
+        tcgen05_mbar_init(&mbar[1], 1);
+    }
