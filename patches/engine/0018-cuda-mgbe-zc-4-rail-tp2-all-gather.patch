diff --git a/zig/tests/cuda/mgbe_zc_gather_tests.zig b/zig/tests/cuda/mgbe_zc_gather_tests.zig
new file mode 100644
index 000000000..8cf839934
--- /dev/null
+++ b/zig/tests/cuda/mgbe_zc_gather_tests.zig
@@ -0,0 +1,178 @@
+//! Two-rank /dev/mgbe_zc zero-copy all-gather against NCCL byte-for-byte: `tf-cuda-test mgbe-zc-gather <rank>`.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const Gpu = check.Gpu;
+
+const cap: usize = 16 << 20;
+const sizes = [_]usize{
+    64,
+    4096,
+    8192,
+    16384,
+    32768,
+    65536,
+    131072,
+    131072 + 128, // triggers DDP with trailing short SPH=1 packet
+    262144,
+    524288 + 4096, // DDP with short tail across 4 rails
+    1 << 20,
+    4 << 20,
+    8 << 20,
+    cap,
+};
+const graph_gathers = 4;
+const graph_replays = 32;
+
+fn shard(out: []u8, seed: u64, rank: usize) void {
+    var rng = std.Random.DefaultPrng.init(seed *% 1000003 +% rank *% 7919 +% out.len);
+    rng.random().bytes(out);
+}
+
+fn expected(want: []u8, n: usize, seed: u64) void {
+    for (0..2) |r| shard(want[r * n ..][0..n], seed, r);
+}
+
+pub fn run(gpu: Gpu, rank: usize) !void {
+    const a = gpu.gpa;
+    try check.expect(std.c.getenv("NCCL_COMM_ID") != null, "mgbe-zc-gather: NCCL_COMM_ID must name rank 0", .{});
+    try check.expect(rank < 2, "mgbe-zc-gather: rank {d} must be 0 or 1", .{rank});
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var g = try cuda.tp_group.Group.open(gpu.d, rank, 2);
+    defer g.close();
+    try g.openMgbeZc(a, gpu.d, s, cap);
+    try check.expect(g.zc != null, "mgbe-zc-gather: /dev/mgbe_zc did not come up on both ranks", .{});
+
+    const most = cap;
+    var mine = try cuda.DeviceBuffer.alloc(gpu.d, most);
+    defer mine.free();
+    var by_group = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most);
+    defer by_group.free();
+    var by_nccl = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most);
+    defer by_nccl.free();
+    const host = try a.alloc(u8, most);
+    defer a.free(host);
+    const got = try a.alloc(u8, 2 * most);
+    defer a.free(got);
+    const want = try a.alloc(u8, 2 * most);
+    defer a.free(want);
+
+    for (sizes) |n| for ([_]u64{ 1, 2 }) |seed| {
+        shard(host[0..n], seed, rank);
+        try mine.upload(0, host[0..n]);
+        try g.allGather(s, mine.ptr, by_group.ptr, n);
+        try g.lib.check(g.lib.api.ncclAllGather(mine.ptr, by_nccl.ptr, n, .u8, g.comm, s.handle), "ncclAllGather");
+        try s.synchronize();
+        try g.check();
+        expected(want, n, seed);
+        try by_group.download(0, got[0 .. 2 * n]);
+        try check.sameBytes("mgbe_zc all-gather vs expected", got[0 .. 2 * n], want[0 .. 2 * n]);
+        try by_nccl.download(0, got[0 .. 2 * n]);
+        try check.sameBytes("NCCL all-gather vs expected", got[0 .. 2 * n], want[0 .. 2 * n]);
+        if (seed == 2 and rank == 0) std.debug.print("  mgbe-zc-gather size {d} B OK\n", .{n});
+    };
+    check.pass("mgbe-zc-gather rank {d}: all {d} sizes (64 B..16 MiB, eager + DDP + short tail) bit-exact", .{ rank, sizes.len });
+
+    // CUDA Graph capture + replay (decode-sized gathers)
+    try replays(gpu, &g, s, rank);
+
+    // Stress: 200 mixed eager + 16 bulk DDP back-to-back
+    for (0..200) |i| {
+        const n = ([_]usize{ 4096, 16384, 32768, 65536, 131072 })[i % 5];
+        const seed: u64 = 1000 + i;
+        shard(host[0..n], seed, rank);
+        try mine.upload(0, host[0..n]);
+        try g.allGather(s, mine.ptr, by_group.ptr, n);
+        try s.synchronize();
+        try g.check();
+        expected(want, n, seed);
+        try by_group.download(0, got[0 .. 2 * n]);
+        try check.sameBytes("mgbe_zc eager stress", got[0 .. 2 * n], want[0 .. 2 * n]);
+    }
+    for (0..16) |i| {
+        const n = ([_]usize{ 2 << 20, 4 << 20, 8 << 20, 16 << 20 })[i % 4];
+        const seed: u64 = 2000 + i;
+        shard(host[0..n], seed, rank);
+        try mine.upload(0, host[0..n]);
+        try g.allGather(s, mine.ptr, by_group.ptr, n);
+        try s.synchronize();
+        try g.check();
+        expected(want, n, seed);
+        try by_group.download(0, got[0 .. 2 * n]);
+        try check.sameBytes("mgbe_zc DDP stress", got[0 .. 2 * n], want[0 .. 2 * n]);
+    }
+    check.pass("mgbe-zc-gather rank {d}: 200 eager + 16 DDP stress exchanges passed", .{rank});
+
+    // Timing: mgbe_zc vs NCCL across decode & prefill sizes
+    var t0 = try cuda.Event.init(gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(gpu.d, true);
+    defer t1.deinit();
+    for ([_]struct { n: usize, reps: usize }{
+        .{ .n = 4096, .reps = 500 },
+        .{ .n = 16384, .reps = 500 },
+        .{ .n = 32768, .reps = 500 },
+        .{ .n = 65536, .reps = 300 },
+        .{ .n = 2 << 20, .reps = 20 },
+        .{ .n = 8 << 20, .reps = 10 },
+        .{ .n = 16 << 20, .reps = 6 },
+    }) |tc| {
+        var us: [2]f64 = undefined;
+        for (0..2) |which| {
+            for (0..2) |round| {
+                try t0.record(s);
+                for (0..tc.reps) |_| {
+                    if (which == 0)
+                        try g.allGather(s, mine.ptr, by_group.ptr, tc.n)
+                    else
+                        try g.lib.check(g.lib.api.ncclAllGather(mine.ptr, by_nccl.ptr, tc.n, .u8, g.comm, s.handle), "ncclAllGather");
+                }
+                try t1.record(s);
+                try t1.synchronize();
+                if (round == 1) us[which] = @as(f64, try cuda.Event.elapsedMs(t0, t1)) * 1000.0 / @as(f64, @floatFromInt(tc.reps));
+            }
+        }
+        try g.check();
+        const gbps_zc = (@as(f64, @floatFromInt(tc.n)) * 8.0) / (us[0] * 1000.0);
+        const gbps_nccl = (@as(f64, @floatFromInt(tc.n)) * 8.0) / (us[1] * 1000.0);
+        check.pass("mgbe-zc-gather rank {d}: {d} B/rank: mgbe_zc {d:.1} us ({d:.2} Gbps/dir) vs NCCL {d:.1} us ({d:.2} Gbps/dir)", .{
+            rank, tc.n, us[0], gbps_zc, us[1], gbps_nccl,
+        });
+    }
+}
+
+fn replays(gpu: Gpu, g: *cuda.tp_group.Group, s: cuda.Stream, rank: usize) !void {
+    const a = gpu.gpa;
+    const n: usize = 16384;
+    var mine = try cuda.DeviceBuffer.alloc(gpu.d, graph_gathers * n);
+    defer mine.free();
+    var all = try cuda.DeviceBuffer.alloc(gpu.d, graph_gathers * 2 * n);
+    defer all.free();
+    try cuda.graph.beginCapture(s, .thread_local);
+    for (0..graph_gathers) |i| try g.allGather(s, mine.ptr + i * n, all.ptr + i * 2 * n, n);
+    var captured = try cuda.graph.endCapture(s);
+    defer captured.deinit();
+    var exec = try captured.instantiate();
+    defer exec.deinit();
+    const host = try a.alloc(u8, graph_gathers * n);
+    defer a.free(host);
+    const got = try a.alloc(u8, graph_gathers * 2 * n);
+    defer a.free(got);
+    const want = try a.alloc(u8, graph_gathers * 2 * n);
+    defer a.free(want);
+    for (0..graph_replays) |r| {
+        for (0..graph_gathers) |i| {
+            const seed = 500 + r * graph_gathers + i;
+            shard(host[i * n ..][0..n], seed, rank);
+            expected(want[i * 2 * n ..][0 .. 2 * n], n, seed);
+        }
+        try mine.upload(0, host);
+        try exec.launchOn(s);
+        try s.synchronize();
+        try g.check();
+        try all.download(0, got);
+        try check.sameBytes("mgbe_zc graph replay", got, want);
+    }
+    check.pass("mgbe-zc-gather rank {d}: CUDA Graph ({d} gathers x {d} replays) bit-exact", .{ rank, graph_gathers, graph_replays });
+}
