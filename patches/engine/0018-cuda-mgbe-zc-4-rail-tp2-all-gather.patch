diff --git a/zig/src/cuda/mgbe_zc.zig b/zig/src/cuda/mgbe_zc.zig
new file mode 100644
index 000000000..e5a8126f2
--- /dev/null
+++ b/zig/src/cuda/mgbe_zc.zig
@@ -0,0 +1,1560 @@
+//! Two-rank TP all-gather over /dev/mgbe_zc (4x25GbE zero-copy MGBE on Jetson AGX Thor).
+//!
+//! Reuses kernels.roce_gather on the GPU stream (100% CUDA-Graph capturable) with a 2-slot staging region allocated
+//! via CUDA VMM CU_MEM_LOCATION_TYPE_HOST_NUMA and registered for contiguous 48-bit SMMU IOVA across all active ports:
+//!   - Small stripes (<= TF_MGBE_ZC_EAGER_KB, default 32 KiB/rail): 0.5-RTT raw L2 eager frames on VDMA 2 (0x88B5)
+//!     with zero handshake (~4-6 us 1-way wire latency for decode/verify gathers).
+//!   - Bulk stripes (> TF_MGBE_ZC_EAGER_KB, up to TF_MGBE_ZC_MAX_KB default 16 MiB/rank): hardware split-header
+//!     DDP (SPH=1, 64B header + 8192B payload) directly into recv[slot] SMMU IOVA on VDMA 3 (0x88B6) with CTS/ACK
+//!     and Go-Back-N retransmit (~90 Gbps across 4 rails for prefill gathers).
+const std = @import("std");
+const builtin = @import("builtin");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const memory = @import("memory.zig");
+const Module = @import("module.zig").Module;
+const Function = @import("module.zig").Function;
+const launch = @import("launch.zig");
+const tp_group = @import("tp_group.zig");
+const Stream = @import("stream.zig").Stream;
+const kernels = @import("kernels.zig");
+const nap = @import("roce_nap.zig");
+const uapi = @import("mgbe_zc_uapi.zig");
+
+pub const max_ports = uapi.max_ports;
+const slots: usize = 2;
+const flag_stride: usize = 128;
+const threads: u32 = 512;
+const max_blocks: usize = 8;
+const idle_spins: u64 = 20_000_000;
+const spin_limit: u32 = 40_000_000; // ~23s on Thor HOST_NUMA (> 15s worker timeout)
+const flag_retrans: u8 = 1;
+
+const hdr_bytes: usize = 64;
+const max_payload: usize = 8192;
+const ctrl_rx_stride: usize = 9216; // holds full 64B hdr + 8192B eager jumbo frame (64B aligned)
+const data_rx_stride: usize = 256; // SPH=1 splits 64B header here; 8192B payload lands directly in CUDA HOST_NUMA
+const tx_batch_pkts: u32 = 16;
+const bulk_win_max_pkts: u32 = 512; // 4 MiB per DDP window (fits multiple recovery postings inside 4096-desc ring)
+const wire_magic: u32 = 0x5A433247; // 'ZC2G'
+
+// Per-port anonymous mmap pool layout (40 MiB):
+//   [0 .. 256 KiB)              ctrl_q TX headers  (4096 * 64B)
+//   [256 KiB .. 512 KiB)        data_q TX headers  (4096 * 64B)
+//   [512 KiB .. 1536 KiB)       data_q RX headers  (4096 * 256B)
+//   [2 MiB .. 38 MiB)           ctrl_q RX buffers  (4096 * 9216B)
+const port_pool_bytes: usize = 40 << 20;
+const ctrl_tx_off: usize = 0;
+const data_tx_off: usize = 256 << 10;
+const data_rx_off: usize = 512 << 10;
+const ctrl_rx_off: usize = 2 << 20;
+
+const c_seq: usize = 0;
+const c_nbytes: usize = 1; // + slot
+const c_error: usize = 3;
+const c_hca: usize = 4;
+const c_peer: usize = 5;
+
+const Op = enum(u8) {
+    probe = 0x01,
+    probe_ack = 0x02,
+    eager = 0x10,
+    cts = 0x12,
+    bulk_data = 0x13,
+    ack = 0x14,
+    nack = 0x15,
+};
+
+const WireHdr = extern struct {
+    dst_mac: [6]u8 = @splat(0), // 0..5
+    src_mac: [6]u8 = @splat(0), // 6..11
+    ethertype_be: u16 = 0, // 12..13
+    opcode: u8 = 0, // 14
+    flags: u8 = 0, // 15
+    win_pkts: u16 = 0, // 16..17
+    total_pkts: u16 = 0, // 18..19
+    seq: u32 = 0, // 20..23
+    psn: u32 = 0, // 24..27
+    payload_len: u32 = 0, // 28..31
+    nbytes: u32 = 0, // 32..35
+    win_start: u32 = 0, // 36..39
+    cts_gen: u32 = 0, // 40..43
+    pad: [16]u8 = @splat(0), // 44..59
+    magic: u32 = wire_magic, // 60..63
+};
+
+comptime {
+    std.debug.assert(@sizeOf(WireHdr) == hdr_bytes);
+}
+
+pub const Error = error{
+    UnsupportedPlatform,
+    VmmUnavailable,
+    DeviceUnavailable,
+    NoPorts,
+    IoctlFailed,
+    MmapFailed,
+    MrFailed,
+    ProbeFailed,
+    PeerRefused,
+    ProxyFailed,
+    Misaligned,
+};
+
+/// Two-rank region geometry matching roce_gather.cu (`world = 2`, `peers = 1`, `n_hca = n_ports <= 4`).
+pub const Layout = struct {
+    slot_bytes: usize,
+    recv: usize, // recv[slot][slot_bytes]
+    flags: usize, // flags[slot][rail] * flag_stride
+    send: usize, // send[slot][slot_bytes]
+    ctrl: usize, // ctrl words (flag_stride bytes)
+    total: usize,
+
+    pub fn of(max_bytes: usize) Layout {
+        const s = std.mem.alignForward(usize, @max(max_bytes, 4096), 4096);
+        const flags = slots * s;
+        const send = flags + slots * max_ports * flag_stride;
+        const ctrl = send + slots * s;
+        return .{ .slot_bytes = s, .recv = 0, .flags = flags, .send = send, .ctrl = ctrl, .total = ctrl + flag_stride };
+    }
+
+    pub fn recvAt(l: Layout, slot: usize) usize {
+        return l.recv + slot * l.slot_bytes;
+    }
+
+    pub fn sendAt(l: Layout, slot: usize) usize {
+        return l.send + slot * l.slot_bytes;
+    }
+
+    pub fn flagAt(l: Layout, slot: usize, rail: usize, n_ports: usize) usize {
+        return l.flags + (slot * n_ports + rail) * flag_stride;
+    }
+};
+
+/// TF_MGBE_ZC: 0 disables; 1 requires attempt; unset/auto attempts on TP=2 Linux when /dev/mgbe_zc exists.
+pub fn wanted(world: usize) bool {
+    if (comptime builtin.os.tag != .linux) return false;
+    if (world != 2) return false;
+    const v = std.c.getenv("TF_MGBE_ZC") orelse return true;
+    const s = std.mem.span(v);
+    return !(std.mem.eql(u8, s, "0") or std.mem.eql(u8, s, "off"));
+}
+
+fn debugOn() bool {
+    const v = std.c.getenv("TF_MGBE_ZC_DEBUG") orelse return false;
+    const s = std.mem.span(v);
+    return s.len > 0 and !std.mem.eql(u8, s, "0");
+}
+
+fn envUsize(name: [:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default;
+}
+
+/// TF_MGBE_ZC_MAX_KB in bytes (default 16 MiB per rank).
+pub fn maxBytesFromEnv() usize {
+    const kb = envUsize("TF_MGBE_ZC_MAX_KB", 16384);
+    const clamped: usize = @min(kb, 65536);
+    return @max(@as(usize, 64 << 10), clamped << 10);
+}
+
+fn eagerMaxBytesFromEnv() usize {
+    const kb = envUsize("TF_MGBE_ZC_EAGER_KB", 32);
+    const clamped: usize = @min(kb, 128);
+    return clamped << 10; // up to 16 jumbo packets per rail (mask fits u32)
+}
+
+fn timeoutNsFromEnv() u64 {
+    const s = envUsize("TF_MGBE_ZC_TIMEOUT_S", 15);
+    return @as(u64, @max(s, 2)) * 1_000_000_000;
+}
+
+inline fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * 1_000_000_000 + @as(u64, @intCast(ts.nsec));
+}
+
+inline fn dmbOshst() void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        asm volatile ("dmb oshst" ::: .{ .memory = true });
+    }
+}
+
+inline fn dsbSy() void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        asm volatile ("dsb sy" ::: .{ .memory = true });
+    }
+}
+
+inline fn mmioWrite32(base: [*]volatile u8, off: usize, val: u32) void {
+    dmbOshst();
+    const p: *volatile u32 = @ptrCast(@alignCast(base + off));
+    p.* = val;
+}
+
+inline fn cacheCleanRange(ptr: [*]const u8, len: usize) void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        if (len == 0) return;
+        var a: usize = @intFromPtr(ptr) & ~@as(usize, 63);
+        const end: usize = @intFromPtr(ptr) + len;
+        while (a < end) : (a += 64) {
+            asm volatile ("dc cvac, %[a]"
+                :
+                : [a] "r" (a),
+                : .{ .memory = true });
+        }
+        asm volatile ("dsb sy" ::: .{ .memory = true });
+    }
+}
+
+inline fn cacheInvalRange(ptr: [*]const u8, len: usize) void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        if (len == 0) return;
+        var a: usize = @intFromPtr(ptr) & ~@as(usize, 63);
+        const end: usize = @intFromPtr(ptr) + len;
+        while (a < end) : (a += 64) {
+            asm volatile ("dc civac, %[a]"
+                :
+                : [a] "r" (a),
+                : .{ .memory = true });
+        }
+        asm volatile ("dsb sy\n\tisb" ::: .{ .memory = true });
+    }
+}
+
+fn pinCpu(cpu: i32) void {
+    if (comptime builtin.os.tag != .linux) return;
+    if (cpu < 0 or cpu >= 1024) return;
+    var set: [16]usize = @splat(0);
+    const idx: usize = @intCast(@divTrunc(cpu, @bitSizeOf(usize)));
+    const bit: u6 = @intCast(@mod(cpu, @bitSizeOf(usize)));
+    set[idx] = @as(usize, 1) << bit;
+    _ = std.os.linux.syscall3(.sched_setaffinity, 0, @sizeOf(@TypeOf(set)), @intFromPtr(&set));
+}
+
+fn ioctlCall(fd: i32, req: u32, arg: usize) !void {
+    const rc = std.os.linux.ioctl(fd, req, arg);
+    if (@as(isize, @bitCast(rc)) < 0) return error.IoctlFailed;
+}
+
+fn mmapFile(fd: i32, len: usize, off: u64) ![*]align(4096) u8 {
+    const rc = std.os.linux.mmap(null, len, .{ .READ = true, .WRITE = true }, .{ .TYPE = .SHARED }, fd, @intCast(off));
+    const addr: isize = @bitCast(rc);
+    if (addr < 0) return error.MmapFailed;
+    return @ptrFromInt(rc);
+}
+
+fn mmapAnon(len: usize) ![*]align(4096) u8 {
+    const rc = std.os.linux.mmap(null, len, .{ .READ = true, .WRITE = true }, .{ .TYPE = .PRIVATE, .ANONYMOUS = true, .POPULATE = true }, -1, 0);
+    const addr: isize = @bitCast(rc);
+    if (addr < 0) return error.MmapFailed;
+    return @ptrFromInt(rc);
+}
+
+fn munmapPtr(ptr: [*]align(4096) u8, len: usize) void {
+    _ = std.os.linux.munmap(ptr, len);
+}
+
+/// CUDA VMM HOST_NUMA buffer: directly accessible by both GPU kernels and /dev/mgbe_zc FOLL_LONGTERM SMMU DMA.
+const HostNumaRegion = struct {
+    d: *const Driver,
+    vmm: abi.VmmApi,
+    handle: u64 = 0,
+    va: u64 = 0,
+    size: usize = 0,
+
+    fn alloc(d: *const Driver, req_bytes: usize) !HostNumaRegion {
+        const vmm = d.vmm orelse return error.VmmUnavailable;
+        var dev: abi.Device = 0;
+        try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        var prop: abi.MemAllocationProp = .{
+            .type = abi.cu_mem_allocation_type_pinned,
+            .location = .{ .type = abi.cu_mem_location_type_host_numa, .id = 0 },
+        };
+        var gran: usize = 0;
+        try d.check(vmm.cuMemGetAllocationGranularity(&gran, &prop, abi.cu_mem_alloc_granularity_minimum), "cuMemGetAllocationGranularity");
+        if (gran == 0) return error.VmmUnavailable;
+        const sz = std.mem.alignForward(usize, req_bytes, gran);
+        var handle: u64 = 0;
+        try d.check(vmm.cuMemCreate(&handle, sz, &prop, 0), "cuMemCreate(HOST_NUMA)");
+        errdefer _ = vmm.cuMemRelease(handle);
+        var va: u64 = 0;
+        try d.check(vmm.cuMemAddressReserve(&va, sz, gran, 0, 0), "cuMemAddressReserve");
+        errdefer _ = vmm.cuMemAddressFree(va, sz);
+        try d.check(vmm.cuMemMap(va, sz, 0, handle, 0), "cuMemMap");
+        errdefer _ = vmm.cuMemUnmap(va, sz);
+        var acc = [2]abi.MemAccessDesc{
+            .{ .location = .{ .type = abi.cu_mem_location_type_device, .id = dev }, .flags = abi.cu_mem_access_flags_prot_readwrite },
+            .{ .location = .{ .type = abi.cu_mem_location_type_host_numa, .id = 0 }, .flags = abi.cu_mem_access_flags_prot_readwrite },
+        };
+        try d.check(vmm.cuMemSetAccess(va, sz, &acc, 2), "cuMemSetAccess");
+        const bytes: [*]u8 = @ptrFromInt(va);
+        @memset(bytes[0..sz], 0);
+        return .{ .d = d, .vmm = vmm, .handle = handle, .va = va, .size = sz };
+    }
+
+    fn ptr(r: HostNumaRegion) [*]u8 {
+        return @ptrFromInt(r.va);
+    }
+
+    fn free(r: *HostNumaRegion) void {
+        if (r.va != 0) {
+            _ = r.vmm.cuMemUnmap(r.va, r.size);
+            _ = r.vmm.cuMemAddressFree(r.va, r.size);
+            _ = r.vmm.cuMemRelease(r.handle);
+        }
+        r.* = undefined;
+        r.va = 0;
+    }
+};
+
+const Queue = struct {
+    port: u32 = 0,
+    qidx: u32 = 0,
+    hw_chan: u32 = 0,
+    tx_ring_iova: u64 = 0,
+    rx_ring_iova: u64 = 0,
+    tx_ring: ?[*]align(4096) uapi.HwDesc = null,
+    rx_ring: ?[*]align(4096) uapi.HwDesc = null,
+    reg_page: ?[*]align(4096) u8 = null,
+    ch_reg: [*]volatile u8 = undefined,
+    tx_prod: u32 = 0,
+    tx_cons: u32 = 0,
+    rx_prod: u32 = 0,
+    rx_cons: u32 = 0,
+    tx_hdr_va: [*]u8 = undefined,
+    tx_hdr_iova: u64 = 0,
+    rx_buf_va: [*]u8 = undefined,
+    rx_buf_iova: u64 = 0,
+    rx_stride: usize = 0,
+    started: bool = false,
+    tx_desc_cnt: [uapi.ring_desc_cnt]u8 = @splat(0),
+
+    fn setup(q: *Queue, fd: i32, port: u32, qidx: u32, sph: bool, tx_va: [*]u8, tx_iova: u64, rx_va: [*]u8, rx_iova: u64, rx_stride: usize) !void {
+        q.* = .{
+            .port = port,
+            .qidx = qidx,
+            .tx_hdr_va = tx_va,
+            .tx_hdr_iova = tx_iova,
+            .rx_buf_va = rx_va,
+            .rx_buf_iova = rx_iova,
+            .rx_stride = rx_stride,
+        };
+        var qa: uapi.QueueAlloc = .{ .port = port, .qidx = qidx };
+        try ioctlCall(fd, uapi.ioc_queue_alloc, @intFromPtr(&qa));
+        q.hw_chan = qa.hw_chan;
+        q.tx_ring_iova = qa.tx_ring_iova;
+        q.rx_ring_iova = qa.rx_ring_iova;
+        q.tx_ring = @ptrCast(try mmapFile(fd, uapi.ring_bytes, qa.mmap_tx_off));
+        errdefer if (q.tx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.rx_ring = @ptrCast(try mmapFile(fd, uapi.ring_bytes, qa.mmap_rx_off));
+        errdefer if (q.rx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.reg_page = try mmapFile(fd, uapi.reg_map_bytes, qa.mmap_reg_off);
+        errdefer if (q.reg_page) |p| munmapPtr(p, uapi.reg_map_bytes);
+        q.ch_reg = @as([*]volatile u8, @ptrCast(q.reg_page.?)) + qa.ch_reg_off;
+
+        var init_tail: u32 = 0;
+        if (!sph) {
+            const rx = q.rx_ring.?;
+            for (0..uapi.ring_desc_cnt - 1) |i| {
+                const b = rx_iova + @as(u64, i) * rx_stride;
+                rx[i] = .{
+                    .d0 = @truncate(b),
+                    .d1 = @truncate(b >> 32),
+                    .d2 = 0,
+                    .d3 = uapi.desc_own,
+                };
+            }
+            rx[uapi.ring_desc_cnt - 1].d3 = 0;
+            q.rx_prod = uapi.ring_desc_cnt - 1;
+            q.rx_cons = 0;
+            init_tail = uapi.ring_desc_cnt - 1;
+        }
+        dsbSy();
+        var qs: uapi.QueueStart = .{
+            .port = port,
+            .qidx = qidx,
+            .rx_buf_size = 9216,
+            .sph_enable = if (sph) 1 else 0,
+            .sph_split_bytes = if (sph) hdr_bytes else 0,
+            .init_rx_tail_idx = init_tail,
+        };
+        try ioctlCall(fd, uapi.ioc_queue_start, @intFromPtr(&qs));
+        q.started = true;
+    }
+
+    fn teardown(q: *Queue, fd: i32) void {
+        if (q.started and fd >= 0) {
+            var qst: uapi.QueueStop = .{ .port = q.port, .qidx = q.qidx };
+            _ = std.os.linux.ioctl(fd, uapi.ioc_queue_stop, @intFromPtr(&qst));
+            q.started = false;
+        }
+        if (q.reg_page) |p| munmapPtr(p, uapi.reg_map_bytes);
+        if (q.rx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        if (q.tx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.reg_page = null;
+        q.rx_ring = null;
+        q.tx_ring = null;
+    }
+
+    fn reclaimTx(q: *Queue) void {
+        const tx = q.tx_ring.?;
+        while (q.tx_cons != q.tx_prod) {
+            const c0 = q.tx_cons & uapi.ring_mask;
+            const cnt: u32 = q.tx_desc_cnt[c0];
+            const last = (q.tx_cons +% cnt -% 1) & uapi.ring_mask;
+            if ((@atomicLoad(u32, &tx[last].d3, .acquire) & uapi.desc_own) != 0) break;
+            q.tx_cons +%= cnt;
+        }
+    }
+
+    fn ringTx(q: *Queue) void {
+        const tail = q.tx_prod & uapi.ring_mask;
+        mmioWrite32(q.ch_reg, uapi.ch_tdtlp, @truncate(q.tx_ring_iova +% @as(u64, tail) * 16));
+    }
+
+    fn ringRx(q: *Queue) void {
+        const tail = q.rx_prod & uapi.ring_mask;
+        mmioWrite32(q.ch_reg, uapi.ch_rdtlp, @truncate(q.rx_ring_iova +% @as(u64, tail) * 16));
+    }
+
+    fn sendCtrlHdr(q: *Queue, local_mac: [6]u8, peer_mac: [6]u8, in: WireHdr) void {
+        while ((q.tx_prod -% q.tx_cons) >= (uapi.ring_desc_cnt - 8)) q.reclaimTx();
+        const idx = q.tx_prod & uapi.ring_mask;
+        const h: *WireHdr = @ptrCast(@alignCast(q.tx_hdr_va + @as(usize, idx) * hdr_bytes));
+        h.* = in;
+        h.dst_mac = peer_mac;
+        h.src_mac = local_mac;
+        h.ethertype_be = std.mem.nativeToBig(u16, uapi.ethtype_ctrl);
+        h.payload_len = 0;
+        h.magic = wire_magic;
+        cacheCleanRange(@ptrCast(h), hdr_bytes);
+
+        const hiova = q.tx_hdr_iova + @as(u64, idx) * hdr_bytes;
+        const tx = q.tx_ring.?;
+        q.tx_desc_cnt[idx] = 1;
+        tx[idx].d0 = @truncate(hiova);
+        tx[idx].d1 = @truncate(hiova >> 32);
+        tx[idx].d2 = hdr_bytes;
+        dsbSy();
+        @atomicStore(u32, &tx[idx].d3, uapi.desc_own | uapi.desc_fd | uapi.desc_ld | hdr_bytes, .release);
+        q.tx_prod +%= 1;
+        q.ringTx();
+    }
+
+    fn sendGather(q: *Queue, ethertype: u16, local_mac: [6]u8, peer_mac: [6]u8, in: WireHdr, pay_iova: u64, plen: u32, ring_db: bool) void {
+        if (plen == 0) {
+            q.sendCtrlHdr(local_mac, peer_mac, in);
+            return;
+        }
+        while ((q.tx_prod -% q.tx_cons) >= (uapi.ring_desc_cnt - 8)) q.reclaimTx();
+        const d0 = q.tx_prod & uapi.ring_mask;
+        const d1 = (q.tx_prod +% 1) & uapi.ring_mask;
+        const h: *WireHdr = @ptrCast(@alignCast(q.tx_hdr_va + @as(usize, d0) * hdr_bytes));
+        h.* = in;
+        h.dst_mac = peer_mac;
+        h.src_mac = local_mac;
+        h.ethertype_be = std.mem.nativeToBig(u16, ethertype);
+        h.payload_len = plen;
+        h.magic = wire_magic;
+        cacheCleanRange(@ptrCast(h), hdr_bytes);
+
+        const tx = q.tx_ring.?;
+        q.tx_desc_cnt[d0] = 2;
+        tx[d1].d0 = @truncate(pay_iova);
+        tx[d1].d1 = @truncate(pay_iova >> 32);
+        tx[d1].d2 = plen & uapi.tdes2_b1l_mask;
+        tx[d1].d3 = uapi.desc_own | uapi.desc_ld;
+        dmbOshst();
+
+        const hiova = q.tx_hdr_iova + @as(u64, d0) * hdr_bytes;
+        tx[d0].d0 = @truncate(hiova);
+        tx[d0].d1 = @truncate(hiova >> 32);
+        tx[d0].d2 = hdr_bytes;
+        dsbSy();
+        const fl: u32 = (@as(u32, hdr_bytes) + plen) & uapi.tdes3_fl_mask;
+        @atomicStore(u32, &tx[d0].d3, uapi.desc_own | uapi.desc_fd | fl, .release);
+        q.tx_prod +%= 2;
+        if (ring_db) q.ringTx();
+    }
+
+    const CtrlRx = struct { hdr: WireHdr, payload: []const u8, valid: bool };
+
+    fn peekCtrl(q: *Queue) ?CtrlRx {
+        const rx = q.rx_ring.?;
+        const idx = q.rx_cons & uapi.ring_mask;
+        const d3 = @atomicLoad(u32, &rx[idx].d3, .acquire);
+        if ((d3 & uapi.desc_own) != 0) return null;
+
+        const slot_va = q.rx_buf_va + @as(usize, idx) * q.rx_stride;
+        const wlen: usize = d3 & uapi.rdes3_pl_mask;
+        const inv_len = @min(q.rx_stride, @max(hdr_bytes, wlen));
+        cacheInvalRange(slot_va, inv_len);
+        const h: *const WireHdr = @ptrCast(@alignCast(slot_va));
+        const ok = (d3 & uapi.rdes3_es_mgbe) == 0 and (d3 & uapi.desc_ctxt) == 0 and
+            wlen >= hdr_bytes and h.magic == wire_magic and wlen >= hdr_bytes + h.payload_len;
+        const plen: usize = if (ok) h.payload_len else 0;
+        return .{ .hdr = if (ok) h.* else .{}, .payload = (slot_va + hdr_bytes)[0..plen], .valid = ok };
+    }
+
+    fn consumeCtrl(q: *Queue) void {
+        const rx = q.rx_ring.?;
+        const idx = q.rx_cons & uapi.ring_mask;
+        rx[idx].d3 = 0;
+
+        const refill = q.rx_prod & uapi.ring_mask;
+        cacheInvalRange(q.rx_buf_va + @as(usize, refill) * q.rx_stride, hdr_bytes);
+        const b = q.rx_buf_iova + @as(u64, refill) * q.rx_stride;
+        rx[refill].d0 = @truncate(b);
+        rx[refill].d1 = @truncate(b >> 32);
+        rx[refill].d2 = 0;
+        dsbSy();
+        @atomicStore(u32, &rx[refill].d3, uapi.desc_own, .release);
+
+        q.rx_cons +%= 1;
+        q.rx_prod +%= 1;
+        q.ringRx();
+    }
+
+    fn postDdpRx(q: *Queue, dst_iova: u64, npkts: u32) void {
+        const rx = q.rx_ring.?;
+        for (0..npkts) |k| {
+            const idx = q.rx_prod & uapi.ring_mask;
+            cacheInvalRange(q.rx_buf_va + @as(usize, idx) * q.rx_stride, hdr_bytes + 64);
+            const hiova = q.rx_buf_iova + @as(u64, idx) * q.rx_stride;
+            const piova = dst_iova + @as(u64, k) * max_payload;
+            rx[idx].d0 = @truncate(hiova);
+            rx[idx].d1 = @truncate(hiova >> 32);
+            rx[idx].d2 = @truncate(piova);
+            dmbOshst();
+            @atomicStore(u32, &rx[idx].d3, (@as(u32, @truncate(piova >> 32)) & 0xFFFF) | uapi.desc_own, .release);
+            q.rx_prod +%= 1;
+        }
+        const tail = q.rx_prod & uapi.ring_mask;
+        rx[tail].d3 = 0;
+        q.ringRx();
+    }
+
+    const DataComp = struct { hdr: WireHdr, plen: u32, err: bool };
+
+    fn pollDataRx(q: *Queue) ?DataComp {
+        const rx = q.rx_ring.?;
+        while (q.rx_cons != q.rx_prod) {
+            const idx = q.rx_cons & uapi.ring_mask;
+            const d3 = @atomicLoad(u32, &rx[idx].d3, .acquire);
+            if ((d3 & uapi.desc_own) != 0) return null;
+            q.rx_cons +%= 1;
+            if ((d3 & uapi.desc_ctxt) != 0) continue;
+            const hva = q.rx_buf_va + @as(usize, idx) * q.rx_stride;
+            cacheInvalRange(hva, hdr_bytes);
+            const h: *const WireHdr = @ptrCast(@alignCast(hva));
+            const wpl: u32 = d3 & uapi.rdes3_pl_mask;
+            const plen: u32 = if (wpl >= @as(u32, hdr_bytes)) wpl - @as(u32, hdr_bytes) else 0;
+            const bad = (d3 & uapi.rdes3_es_mgbe) != 0 or h.magic != wire_magic;
+            return .{ .hdr = h.*, .plen = plen, .err = bad };
+        }
+        return null;
+    }
+};
+
+const EagerSlot = struct {
+    seq: u32 = 0,
+    mask: u32 = 0,
+    total_pkts: u16 = 0,
+};
+
+const EagerTxHist = struct {
+    seq: u32 = 0,
+    nbytes: u32 = 0,
+    off: usize = 0,
+    len: usize = 0,
+};
+
+const StashedCts = struct {
+    valid: bool = false,
+    seq: u32 = 0,
+    win_start: u32 = 0,
+    win_pkts: u16 = 0,
+    cts_gen: u32 = 0,
+};
+
+const Rail = struct {
+    rail_idx: usize = 0,
+    port: u32 = 0,
+    local_mac: [6]u8 = @splat(0),
+    peer_mac: [6]u8 = @splat(0),
+    ifname: [16]u8 = @splat(0),
+    pool_va: ?[*]align(4096) u8 = null,
+    pool_mr_id: u32 = 0,
+    pool_iova: u64 = 0,
+    region_iova: u64 = 0,
+    ctrl_q: Queue = .{},
+    data_q: Queue = .{},
+    last_seq: u32 = 0,
+    pin_cpu: i32 = -1,
+    eager_rx: [slots]EagerSlot = @splat(.{}),
+    eager_tx_hist: [slots]EagerTxHist = @splat(.{}),
+    stashed_cts: StashedCts = .{},
+    stashed_ack_seq: u32 = 0,
+    stashed_ack_win: u32 = 0,
+    has_stashed_ack: bool = false,
+    stashed_nack_seq: u32 = 0,
+    stashed_nack_win: u32 = 0,
+    stashed_nack_flush: u16 = 0,
+    stashed_nack_gen: u32 = 0,
+    has_stashed_nack: bool = false,
+    peer_max_seq: u32 = 0,
+    thread: ?std.Thread = null,
+    eager_cnt: u64 = 0,
+    ddp_cnt: u64 = 0,
+    retrans_cnt: u64 = 0,
+};
+
+const Blob = extern struct {
+    ok: u32,
+    n_ports: u32,
+    slot_bytes: u64,
+    max_bytes: u64,
+    port_ids: [max_ports]u32,
+    macs: [max_ports][6]u8,
+};
+
+fn stripeFor(nbytes: usize, rail: usize, n_ports: usize) struct { off: usize, len: usize } {
+    const packs = nbytes / 16;
+    const base = packs / n_ports;
+    const rem = packs % n_ports;
+    const before = rail * base + @min(rail, rem);
+    const mine = base + @as(usize, if (rail < rem) 1 else 0);
+    return .{ .off = before * 16, .len = mine * 16 };
+}
+
+fn parseCsvU32(text: []const u8, out: []u32) usize {
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, text, ',');
+    while (it.next()) |tok| {
+        if (n >= out.len) break;
+        const trimmed = std.mem.trim(u8, tok, " \t\r\n");
+        if (trimmed.len == 0) continue;
+        out[n] = std.fmt.parseInt(u32, trimmed, 10) catch continue;
+        n += 1;
+    }
+    return n;
+}
+
+fn parseCsvI32(text: []const u8, out: []i32) usize {
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, text, ',');
+    while (it.next()) |tok| {
+        if (n >= out.len) break;
+        const trimmed = std.mem.trim(u8, tok, " \t\r\n");
+        if (trimmed.len == 0) continue;
+        out[n] = std.fmt.parseInt(i32, trimmed, 10) catch continue;
+        n += 1;
+    }
+    return n;
+}
+
+pub const Gather = struct {
+    gpa: std.mem.Allocator,
+    d: *const Driver,
+    rank: u8,
+    fd: i32 = -1,
+    n_ports: u32 = 0,
+    rails: [max_ports]Rail = @splat(.{}),
+    layout: Layout,
+    region: HostNumaRegion,
+    region_mr_id: u32 = 0,
+    counters: memory.DeviceBuffer,
+    module: Module,
+    f: Function,
+    max_bytes: usize,
+    eager_max: usize,
+    timeout_ns: u64,
+    debug: bool,
+    running: std.atomic.Value(bool) = .init(false),
+    failed: std.atomic.Value(bool) = .init(false),
+    err: [256]u8 = @splat(0),
+    gathers: u64 = 0,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const Driver, group: *const tp_group.Group, s: Stream, want: bool, max_bytes: usize) !?*Gather {
+        if (comptime builtin.os.tag != .linux) return null;
+        if (group.world != 2) return null;
+        const g = try gpa.create(Gather);
+        var mine: Blob = std.mem.zeroes(Blob);
+        const ok = want and blk: {
+            g.setup(gpa, d, @intCast(group.rank), max_bytes) catch |e| {
+                std.log.warn("mgbe_zc all-gather: {s} ({s}); NCCL carries every gather", .{ @errorName(e), std.mem.sliceTo(&g.err, 0) });
+                break :blk false;
+            };
+            break :blk true;
+        };
+        if (ok) g.fillBlob(&mine);
+        var all: [2]Blob = undefined;
+        group.gather(Blob, d, s, mine, &all) catch |e| {
+            if (ok) g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        const peer = all[1 - group.rank];
+        if (!ok or peer.ok == 0 or peer.n_ports != mine.n_ports or peer.slot_bytes != mine.slot_bytes) {
+            if (ok) g.teardown();
+            gpa.destroy(g);
+            return null;
+        }
+        g.max_bytes = @intCast(@min(mine.max_bytes, peer.max_bytes));
+        for (0..g.n_ports) |r| {
+            g.rails[r].peer_mac = peer.macs[r];
+        }
+        // Barrier before probe so both peers have queues started and peer MACs loaded.
+        var ready_words: [2]u32 = undefined;
+        group.gather(u32, d, s, 1, &ready_words) catch |e| {
+            g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        const probed: u32 = blk: {
+            g.probeAll() catch |e| {
+                std.log.err("mgbe_zc all-gather probe: {s} ({s})", .{ @errorName(e), std.mem.sliceTo(&g.err, 0) });
+                break :blk 0;
+            };
+            break :blk 1;
+        };
+        var verdicts: [2]u32 = undefined;
+        group.gather(u32, d, s, probed, &verdicts) catch |e| {
+            g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        if (verdicts[0] == 0 or verdicts[1] == 0) {
+            g.teardown();
+            gpa.destroy(g);
+            std.log.warn("mgbe_zc all-gather: wire probe failed on a rank; NCCL carries every gather", .{});
+            return null;
+        }
+        g.startWorkers() catch |e| {
+            g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        std.log.info("mgbe_zc all-gather: 2 ranks, {d} rail(s), shards up to {d} KiB (eager <= {d} KiB/rail, DDP above)", .{
+            g.n_ports, g.max_bytes >> 10, g.eager_max >> 10,
+        });
+        return g;
+    }
+
+    fn fail(g: *Gather, comptime fmt: []const u8, args: anytype) void {
+        _ = std.fmt.bufPrint(g.err[0 .. g.err.len - 1], fmt, args) catch {};
+    }
+
+    fn ctrl(g: *Gather) [*]u32 {
+        return @ptrCast(@alignCast(g.region.ptr() + g.layout.ctrl));
+    }
+
+    fn setup(g: *Gather, gpa: std.mem.Allocator, d: *const Driver, rank: u8, max_bytes: usize) !void {
+        g.* = .{
+            .gpa = gpa,
+            .d = d,
+            .rank = rank,
+            .layout = Layout.of(max_bytes),
+            .region = undefined,
+            .counters = undefined,
+            .module = undefined,
+            .f = undefined,
+            .max_bytes = max_bytes,
+            .eager_max = eagerMaxBytesFromEnv(),
+            .timeout_ns = timeoutNsFromEnv(),
+            .debug = debugOn(),
+        };
+        const fd_rc = std.os.linux.open(uapi.dev_path.ptr, .{ .ACCMODE = .RDWR, .CLOEXEC = true }, 0);
+        const fd_signed: isize = @bitCast(fd_rc);
+        if (fd_signed < 0) {
+            g.fail("open {s} failed (errno {d})", .{ uapi.dev_path, -fd_signed });
+            return error.DeviceUnavailable;
+        }
+        g.fd = @intCast(fd_signed);
+        errdefer {
+            _ = std.os.linux.close(g.fd);
+            g.fd = -1;
+        }
+
+        // Discover requested or all present+up+MTU9000+SPH ports.
+        var want_ports: [max_ports]u32 = .{ 0, 1, 2, 3 };
+        var n_want: usize = max_ports;
+        if (std.c.getenv("TF_MGBE_ZC_PORTS")) |v| {
+            const parsed = parseCsvU32(std.mem.span(v), &want_ports);
+            if (parsed > 0) n_want = parsed;
+        }
+        var cpus: [max_ports]i32 = @splat(-1);
+        if (std.c.getenv("TF_MGBE_ZC_CPUS")) |v| {
+            _ = parseCsvI32(std.mem.span(v), &cpus);
+        }
+
+        var count: u32 = 0;
+        for (want_ports[0..n_want]) |p| {
+            if (p >= max_ports) continue;
+            var pi: uapi.PortInfo = .{ .port = p };
+            ioctlCall(g.fd, uapi.ioc_port_info, @intFromPtr(&pi)) catch continue;
+            if (pi.present == 0 or pi.link_up == 0 or pi.sph_supported == 0 or pi.mtu < 8256) continue;
+            g.rails[count] = .{
+                .rail_idx = count,
+                .port = p,
+                .local_mac = pi.mac,
+                .ifname = pi.ifname,
+                .pin_cpu = cpus[count],
+            };
+            count += 1;
+        }
+        if (count == 0) {
+            g.fail("no up MGBE port with MTU>=8256 and SPH=1", .{});
+            return error.NoPorts;
+        }
+        g.n_ports = count;
+
+        // Allocate GPU+NIC shared HOST_NUMA region and register MR once across all ports.
+        g.region = HostNumaRegion.alloc(d, g.layout.total) catch |e| {
+            g.fail("CUDA HOST_NUMA alloc ({d} B) failed: {s}", .{ g.layout.total, @errorName(e) });
+            return e;
+        };
+        errdefer g.region.free();
+
+        var rmr: uapi.MrReq = .{ .va = g.region.va, .len = g.region.size, .dmabuf_fd = -1 };
+        ioctlCall(g.fd, uapi.ioc_reg_mr, @intFromPtr(&rmr)) catch {
+            g.fail("REG_MR region ({d} B) failed", .{g.region.size});
+            return error.MrFailed;
+        };
+        g.region_mr_id = rmr.mr_id;
+        errdefer _ = std.os.linux.ioctl(g.fd, uapi.ioc_dereg_mr, @intFromPtr(&g.region_mr_id));
+
+        g.counters = try memory.DeviceBuffer.alloc(d, 64 * 4);
+        errdefer g.counters.free();
+        const zeros: [64 * 4]u8 = @splat(0);
+        try g.counters.upload(0, &zeros);
+
+        g.module = try Module.load(d, kernels.roce_gather);
+        errdefer g.module.unload();
+        g.f = try g.module.function("roce_gather");
+
+        errdefer g.teardownRails();
+        for (0..g.n_ports) |r| {
+            const rl = &g.rails[r];
+            rl.region_iova = rmr.iova[rl.port];
+            rl.pool_va = try mmapAnon(port_pool_bytes);
+            @memset(rl.pool_va.?[0..port_pool_bytes], 0);
+            cacheInvalRange(rl.pool_va.?, port_pool_bytes);
+            var pmr: uapi.MrReq = .{ .va = @intFromPtr(rl.pool_va.?), .len = port_pool_bytes, .dmabuf_fd = -1 };
+            ioctlCall(g.fd, uapi.ioc_reg_mr, @intFromPtr(&pmr)) catch {
+                g.fail("REG_MR port {d} header pool failed", .{rl.port});
+                return error.MrFailed;
+            };
+            rl.pool_mr_id = pmr.mr_id;
+            rl.pool_iova = pmr.iova[rl.port];
+            try rl.ctrl_q.setup(
+                g.fd,
+                rl.port,
+                0,
+                false,
+                rl.pool_va.? + ctrl_tx_off,
+                rl.pool_iova + ctrl_tx_off,
+                rl.pool_va.? + ctrl_rx_off,
+                rl.pool_iova + ctrl_rx_off,
+                ctrl_rx_stride,
+            );
+            try rl.data_q.setup(
+                g.fd,
+                rl.port,
+                1,
+                true,
+                rl.pool_va.? + data_tx_off,
+                rl.pool_iova + data_tx_off,
+                rl.pool_va.? + data_rx_off,
+                rl.pool_iova + data_rx_off,
+                data_rx_stride,
+            );
+        }
+    }
+
+    fn fillBlob(g: *Gather, b: *Blob) void {
+        b.ok = 1;
+        b.n_ports = g.n_ports;
+        b.slot_bytes = g.layout.slot_bytes;
+        b.max_bytes = g.max_bytes;
+        for (0..g.n_ports) |r| {
+            b.port_ids[r] = g.rails[r].port;
+            b.macs[r] = g.rails[r].local_mac;
+        }
+    }
+
+    /// Bidirectional L2 ctrl + DDP probe on every rail before arming workers.
+    fn probeAll(g: *Gather) !void {
+        for (0..g.n_ports) |r| {
+            try g.probeRail(&g.rails[r]);
+        }
+        // Reset staging bytes used by the probe so sequence 1 starts clean.
+        @memset(g.region.ptr()[0..g.layout.total], 0);
+        cacheCleanRange(g.region.ptr(), g.layout.total);
+    }
+
+    fn probeRail(g: *Gather, rl: *Rail) !void {
+        const deadline = nowNs() + 5_000_000_000;
+        // 1. Ctrl L2 ping-pong verifying peer MAC pairing.
+        var got_peer_probe = false;
+        var got_ack = false;
+        var last_tx: u64 = 0;
+        while (!(got_peer_probe and got_ack)) {
+            const t = nowNs();
+            if (t >= deadline) {
+                g.fail("port {d} ({s}) ctrl probe timed out", .{ rl.port, std.mem.sliceTo(&rl.ifname, 0) });
+                return error.ProbeFailed;
+            }
+            if (!got_ack and (t - last_tx) >= 2_000_000) {
+                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe), .seq = 0x50520000 | rl.port });
+                last_tx = t;
+            }
+            if (rl.ctrl_q.peekCtrl()) |rx| {
+                const h = rx.hdr;
+                const ok = rx.valid;
+                rl.ctrl_q.consumeCtrl();
+                if (!ok) continue;
+                if (h.opcode == @intFromEnum(Op.probe)) {
+                    got_peer_probe = true;
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe_ack), .seq = h.seq });
+                } else if (h.opcode == @intFromEnum(Op.probe_ack)) {
+                    got_ack = true;
+                }
+            }
+        }
+        // 2. 64 KiB (8 packets) bidirectional SPH=1 DDP probe into HOST_NUMA recv[0].
+        const probe_pkts: u32 = 8;
+        const probe_bytes: usize = probe_pkts * max_payload;
+        const send_va = g.region.ptr() + g.layout.sendAt(0);
+        const recv_va = g.region.ptr() + g.layout.recvAt(0);
+        const send_iova = rl.region_iova + g.layout.sendAt(0);
+        const recv_iova = rl.region_iova + g.layout.recvAt(0);
+        const my_tag: u8 = if (g.rank == 0) 0xA5 else 0x5A;
+        const peer_tag: u8 = if (g.rank == 0) 0x5A else 0xA5;
+        for (0..probe_bytes) |i| send_va[i] = my_tag ^ @as(u8, @truncate((i *% 31) >> 3));
+        cacheCleanRange(send_va, probe_bytes);
+        @memset(recv_va[0..probe_bytes], 0xEE);
+        cacheInvalRange(recv_va, probe_bytes);
+
+        rl.data_q.postDdpRx(recv_iova, probe_pkts);
+        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.cts), .seq = 0, .win_start = 0, .win_pkts = probe_pkts, .cts_gen = 1 });
+
+        var peer_cts = false;
+        var tx_sent = false;
+        var peer_ack = false;
+        var rx_got: u32 = 0;
+        var last_cts_tx = nowNs();
+        while (!(rx_got == probe_pkts and peer_ack)) {
+            const t = nowNs();
+            if (t >= deadline) {
+                g.fail("port {d} DDP probe timed out (rx={d}/{d}, cts={}, ack={})", .{ rl.port, rx_got, probe_pkts, peer_cts, peer_ack });
+                return error.ProbeFailed;
+            }
+            if (!tx_sent and !peer_cts and (t - last_cts_tx) >= 2_000_000) {
+                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.cts), .seq = 0, .win_start = 0, .win_pkts = probe_pkts, .cts_gen = 1 });
+                last_cts_tx = t;
+            }
+            while (rl.ctrl_q.peekCtrl()) |rx| {
+                const h = rx.hdr;
+                const ok = rx.valid;
+                rl.ctrl_q.consumeCtrl();
+                if (!ok) continue;
+                if (h.opcode == @intFromEnum(Op.probe)) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe_ack), .seq = h.seq });
+                } else if (h.opcode == @intFromEnum(Op.cts) and h.seq == 0) {
+                    peer_cts = true;
+                } else if (h.opcode == @intFromEnum(Op.ack) and h.seq == 0) {
+                    peer_ack = true;
+                }
+            }
+            if (peer_cts and !tx_sent) {
+                for (0..probe_pkts) |k| {
+                    const last = (k + 1 == probe_pkts);
+                    rl.data_q.sendGather(
+                        uapi.ethtype_data,
+                        rl.local_mac,
+                        rl.peer_mac,
+                        .{ .opcode = @intFromEnum(Op.bulk_data), .seq = 0, .psn = @intCast(k), .win_pkts = probe_pkts, .cts_gen = 1 },
+                        send_iova + @as(u64, k) * max_payload,
+                        max_payload,
+                        last,
+                    );
+                }
+                tx_sent = true;
+            }
+            while (rl.data_q.pollDataRx()) |comp| {
+                if (comp.err or comp.hdr.opcode != @intFromEnum(Op.bulk_data) or comp.hdr.psn != rx_got or comp.plen != max_payload) {
+                    g.fail("port {d} DDP probe bad pkt (err={} psn={d} want={d} plen={d})", .{ rl.port, comp.err, comp.hdr.psn, rx_got, comp.plen });
+                    return error.ProbeFailed;
+                }
+                rx_got += 1;
+                if (rx_got == probe_pkts) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.ack), .seq = 0, .win_start = 0, .win_pkts = probe_pkts });
+                }
+            }
+        }
+        cacheInvalRange(recv_va, probe_bytes);
+        for (0..probe_bytes) |i| {
+            const want = peer_tag ^ @as(u8, @truncate((i *% 31) >> 3));
+            if (recv_va[i] != want) {
+                g.fail("port {d} DDP probe payload mismatch at byte {d} (got 0x{x} want 0x{x})", .{ rl.port, i, recv_va[i], want });
+                return error.ProbeFailed;
+            }
+        }
+        if (g.debug) std.log.info("mgbe_zc rank {d} port {d} ({s}): ctrl+DDP probe OK", .{ g.rank, rl.port, std.mem.sliceTo(&rl.ifname, 0) });
+    }
+
+    fn startWorkers(g: *Gather) !void {
+        g.running.store(true, .release);
+        for (0..g.n_ports) |r| {
+            g.rails[r].thread = try std.Thread.spawn(.{}, railWorker, .{ g, r });
+        }
+    }
+
+    /// Poll ctrl_q for incoming control/eager packets, handling both current and lookahead (next-seq) frames.
+    fn drainCtrlRx(g: *Gather, rl: *Rail) void {
+        while (rl.ctrl_q.peekCtrl()) |rx| {
+            const h = rx.hdr;
+            const ok = rx.valid;
+            if (ok) {
+                if (h.seq != 0 and @as(i32, @bitCast(h.seq -% rl.peer_max_seq)) > 0) rl.peer_max_seq = h.seq;
+                switch (h.opcode) {
+                    @intFromEnum(Op.eager) => {
+                        const slot: usize = h.seq & 1;
+                        if ((h.flags & flag_retrans) != 0 and h.seq != 0 and h.seq == rl.eager_tx_hist[slot].seq and
+                            @as(i32, @bitCast(h.seq -% rl.last_seq)) <= 0)
+                        {
+                            // Peer missed our eager frame after we already exited runEager(h.seq); send[slot] is still intact
+                            // (2-slot ping-pong prevents overwriting slot until peer finishes h.seq and h.seq+1).
+                            const th = rl.eager_tx_hist[slot];
+                            g.sendEagerBurst(rl, th.seq, th.nbytes, th.off, th.len, false);
+                            rl.retrans_cnt += 1;
+                        }
+                        const s = &rl.eager_rx[slot];
+                        if (h.seq != s.seq) {
+                            // Only accept packets for seq >= last_seq + 1 (ignore stale retransmits of old seqs).
+                            if (h.seq != 0 and @as(i32, @bitCast(h.seq -% rl.last_seq)) > 0) {
+                                s.* = .{ .seq = h.seq, .mask = 0, .total_pkts = h.total_pkts };
+                            } else {
+                                rl.ctrl_q.consumeCtrl();
+                                continue;
+                            }
+                        }
+                        if (h.total_pkts > 0 and h.psn < 32 and h.psn < h.total_pkts) {
+                            const bit = @as(u32, 1) << @intCast(h.psn);
+                            if ((s.mask & bit) == 0) {
+                                const st = stripeFor(h.nbytes, rl.rail_idx, g.n_ports);
+                                const dst_off = g.layout.recvAt(slot) + st.off + @as(usize, h.psn) * max_payload;
+                                if (dst_off + rx.payload.len <= g.layout.flags) {
+                                    @memcpy(g.region.ptr()[dst_off..][0..rx.payload.len], rx.payload);
+                                }
+                                s.mask |= bit;
+                            }
+                        } else if (h.total_pkts == 0) {
+                            s.mask = 1;
+                        }
+                    },
+                    @intFromEnum(Op.cts) => {
+                        if (!rl.stashed_cts.valid or
+                            @as(i32, @bitCast(h.seq -% rl.stashed_cts.seq)) > 0 or
+                            (h.seq == rl.stashed_cts.seq and (h.win_start > rl.stashed_cts.win_start or
+                                (h.win_start == rl.stashed_cts.win_start and @as(i32, @bitCast(h.cts_gen -% rl.stashed_cts.cts_gen)) >= 0))))
+                        {
+                            rl.stashed_cts = .{ .valid = true, .seq = h.seq, .win_start = h.win_start, .win_pkts = h.win_pkts, .cts_gen = h.cts_gen };
+                        }
+                    },
+                    @intFromEnum(Op.ack) => {
+                        if (!rl.has_stashed_ack or
+                            @as(i32, @bitCast(h.seq -% rl.stashed_ack_seq)) > 0 or
+                            (h.seq == rl.stashed_ack_seq and h.win_start >= rl.stashed_ack_win))
+                        {
+                            rl.stashed_ack_seq = h.seq;
+                            rl.stashed_ack_win = h.win_start;
+                            rl.has_stashed_ack = true;
+                        }
+                    },
+                    @intFromEnum(Op.nack) => {
+                        if (@as(i32, @bitCast(h.seq -% rl.last_seq)) > 0) {
+                            rl.stashed_nack_seq = h.seq;
+                            rl.stashed_nack_win = h.win_start;
+                            rl.stashed_nack_flush = h.win_pkts;
+                            rl.stashed_nack_gen = h.cts_gen;
+                            rl.has_stashed_nack = true;
+                        }
+                    },
+                    else => {},
+                }
+            }
+            rl.ctrl_q.consumeCtrl();
+        }
+    }
+
+    fn signalFlag(g: *Gather, rl: *Rail, slot: usize, seq: u32) void {
+        const flag_off = g.layout.flagAt(slot, rl.rail_idx, g.n_ports);
+        const flag_ptr: *u32 = @ptrCast(@alignCast(g.region.ptr() + flag_off));
+        @atomicStore(u32, flag_ptr, seq, .release);
+        cacheCleanRange(@ptrCast(flag_ptr), 64);
+    }
+
+    fn sendEagerBurst(g: *Gather, rl: *Rail, seq: u32, nbytes: u32, off: usize, len: usize, is_retrans: bool) void {
+        const slot: usize = seq & 1;
+        const send_iova = rl.region_iova + g.layout.sendAt(slot) + off;
+        const npkts: u16 = if (len == 0) 0 else @intCast((len + max_payload - 1) / max_payload);
+        if (npkts == 0) {
+            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                .opcode = @intFromEnum(Op.eager),
+                .flags = if (is_retrans) flag_retrans else 0,
+                .seq = seq,
+                .nbytes = nbytes,
+                .total_pkts = 0,
+            });
+            return;
+        }
+        for (0..npkts) |k| {
+            const po = k * max_payload;
+            const plen: u32 = @intCast(@min(max_payload, len - po));
+            rl.ctrl_q.sendGather(
+                uapi.ethtype_ctrl,
+                rl.local_mac,
+                rl.peer_mac,
+                .{
+                    .opcode = @intFromEnum(Op.eager),
+                    .flags = if (is_retrans and k == 0) flag_retrans else 0,
+                    .seq = seq,
+                    .psn = @intCast(k),
+                    .total_pkts = npkts,
+                    .nbytes = nbytes,
+                },
+                send_iova + po,
+                plen,
+                k + 1 == npkts,
+            );
+        }
+    }
+
+    fn runEager(g: *Gather, rl: *Rail, seq: u32, nbytes: u32, off: usize, len: usize) !void {
+        const slot: usize = seq & 1;
+        const send_va = g.region.ptr() + g.layout.sendAt(slot) + off;
+        const recv_va = g.region.ptr() + g.layout.recvAt(slot) + off;
+        const total_pkts: u16 = if (len == 0) 0 else @intCast((len + max_payload - 1) / max_payload);
+        const want_mask: u32 = if (total_pkts == 0) 1 else (@as(u32, 1) << @intCast(total_pkts)) - 1;
+
+        if (len > 0) cacheCleanRange(send_va, len);
+        rl.eager_tx_hist[slot] = .{ .seq = seq, .nbytes = nbytes, .off = off, .len = len };
+        g.sendEagerBurst(rl, seq, nbytes, off, len, false);
+        const t0 = nowNs();
+        var last_tx = t0;
+        while (g.running.load(.monotonic)) {
+            g.drainCtrlRx(rl);
+            const es = &rl.eager_rx[slot];
+            if (es.seq == seq and es.mask == want_mask) {
+                if (len > 0) cacheCleanRange(recv_va, len);
+                g.signalFlag(rl, slot, seq);
+                rl.eager_cnt += 1;
+                return;
+            }
+            const t = nowNs();
+            if (t - last_tx >= 500_000) {
+                g.sendEagerBurst(rl, seq, nbytes, off, len, true);
+                rl.retrans_cnt += 1;
+                last_tx = t;
+            }
+            if (t - t0 >= g.timeout_ns) {
+                g.fail("port {d} eager seq {d} ({d} B) timed out (got_seq={d} mask=0x{x}/0x{x})", .{ rl.port, seq, len, es.seq, es.mask, want_mask });
+                return error.ProxyFailed;
+            }
+        }
+        return error.ProxyFailed;
+    }
+
+    fn runDdp(g: *Gather, rl: *Rail, seq: u32, nbytes: u32, off: usize, len: usize) !void {
+        const slot: usize = seq & 1;
+        const send_va = g.region.ptr() + g.layout.sendAt(slot) + off;
+        const send_iova = rl.region_iova + g.layout.sendAt(slot) + off;
+        const recv_va = g.region.ptr() + g.layout.recvAt(slot) + off;
+        const recv_iova = rl.region_iova + g.layout.recvAt(slot) + off;
+        const total_pkts: u32 = @intCast((len + max_payload - 1) / max_payload);
+
+        cacheCleanRange(send_va, len);
+        cacheInvalRange(recv_va, len);
+
+        var win_start: u32 = 0;
+        var cts_gen: u32 = 1;
+        while (win_start < total_pkts) {
+            const win_pkts: u32 = @min(bulk_win_max_pkts, total_pkts - win_start);
+            const win_off = @as(u64, win_start) * max_payload;
+            // Post our DDP RX window and immediately advertise CTS to peer.
+            rl.data_q.postDdpRx(recv_iova + win_off, win_pkts);
+            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                .opcode = @intFromEnum(Op.cts),
+                .seq = seq,
+                .win_start = win_start,
+                .win_pkts = @intCast(win_pkts),
+                .nbytes = nbytes,
+                .cts_gen = cts_gen,
+            });
+
+            var tx_allowed = false;
+            var tx_sent: u32 = 0;
+            var tx_flush: u32 = 0;
+            var tx_acked = false;
+            var rx_got: u32 = 0;
+            var rx_skip: u32 = 0;
+            var rx_gap = false;
+            var rx_acked = false;
+            var peer_cts_gen: u32 = 0;
+            const t_win = nowNs();
+            var last_cts_tx = t_win;
+            var last_ack_tx: u64 = 0;
+            var last_rx_activity = t_win;
+
+            while (!(rx_acked and tx_acked)) {
+                if (!g.running.load(.monotonic)) return error.ProxyFailed;
+                g.drainCtrlRx(rl);
+
+                // Consume stashed CTS for this (seq, win_start)
+                if (rl.stashed_cts.valid and rl.stashed_cts.seq == seq and rl.stashed_cts.win_start == win_start) {
+                    if (!tx_allowed or rl.stashed_cts.cts_gen != peer_cts_gen) {
+                        peer_cts_gen = rl.stashed_cts.cts_gen;
+                        tx_allowed = true;
+                        tx_sent = 0;
+                        tx_flush = 0;
+                    }
+                    rl.stashed_cts.valid = false;
+                }
+                if (rl.has_stashed_ack and rl.stashed_ack_seq == seq and rl.stashed_ack_win == win_start) {
+                    tx_acked = true;
+                    rl.has_stashed_ack = false;
+                }
+                if (rl.has_stashed_nack and rl.stashed_nack_seq == seq and rl.stashed_nack_win == win_start) {
+                    if (rl.stashed_nack_gen != peer_cts_gen) {
+                        // Peer posted fresh DDP RX window after `stashed_nack_flush` leftover descriptors:
+                        // emit `tx_flush` short dummy frames to consume those leftovers, then resend the full window.
+                        peer_cts_gen = rl.stashed_nack_gen;
+                        tx_flush = rl.stashed_nack_flush;
+                        tx_sent = 0;
+                        tx_allowed = true;
+                        rl.retrans_cnt += 1;
+                    }
+                    rl.has_stashed_nack = false;
+                }
+                if (!tx_acked and (@as(i32, @bitCast(rl.peer_max_seq -% seq)) > 0 or
+                    (rl.stashed_cts.valid and rl.stashed_cts.seq == seq and rl.stashed_cts.win_start > win_start)))
+                {
+                    tx_acked = true;
+                }
+
+                // Stream TX batch while allowed (never transmit into an unposted peer RX ring).
+                if (tx_allowed and !tx_acked and (tx_flush > 0 or tx_sent < win_pkts)) {
+                    var sent_now: u32 = 0;
+                    while (tx_flush > 0 and sent_now < tx_batch_pkts) {
+                        const ring_db = (sent_now + 1 == tx_batch_pkts) or (tx_flush == 1 and tx_sent == win_pkts);
+                        rl.data_q.sendGather(
+                            uapi.ethtype_data,
+                            rl.local_mac,
+                            rl.peer_mac,
+                            .{
+                                .opcode = @intFromEnum(Op.bulk_data),
+                                .seq = seq,
+                                .win_start = win_start,
+                                .psn = 0xFFFFFFFF,
+                                .win_pkts = @intCast(win_pkts),
+                                .nbytes = nbytes,
+                                .cts_gen = peer_cts_gen,
+                            },
+                            send_iova,
+                            16,
+                            ring_db,
+                        );
+                        tx_flush -= 1;
+                        sent_now += 1;
+                    }
+                    while (tx_flush == 0 and tx_sent < win_pkts and sent_now < tx_batch_pkts) {
+                        const global_p = win_start + tx_sent;
+                        const po = @as(usize, global_p) * max_payload;
+                        const plen: u32 = @intCast(@min(max_payload, len - po));
+                        const ring_db = (sent_now + 1 == tx_batch_pkts) or (tx_sent + 1 == win_pkts);
+                        rl.data_q.sendGather(
+                            uapi.ethtype_data,
+                            rl.local_mac,
+                            rl.peer_mac,
+                            .{
+                                .opcode = @intFromEnum(Op.bulk_data),
+                                .seq = seq,
+                                .win_start = win_start,
+                                .psn = tx_sent,
+                                .win_pkts = @intCast(win_pkts),
+                                .nbytes = nbytes,
+                                .cts_gen = peer_cts_gen,
+                            },
+                            send_iova + po,
+                            plen,
+                            ring_db,
+                        );
+                        tx_sent += 1;
+                        sent_now += 1;
+                    }
+                }
+
+                // Poll RX DDP completions
+                var drained_any = false;
+                while (!rx_acked and (rx_skip > 0 or rx_got < win_pkts)) {
+                    const comp = rl.data_q.pollDataRx() orelse break;
+                    drained_any = true;
+                    last_rx_activity = nowNs();
+                    if (rx_skip > 0) {
+                        rx_skip -= 1;
+                        continue;
+                    }
+                    if (comp.err or comp.hdr.seq != seq or comp.hdr.win_start != win_start or comp.hdr.psn != rx_got) {
+                        rx_gap = true;
+                    }
+                    rx_got += 1;
+                }
+                if (!rx_acked and rx_skip == 0 and rx_got == win_pkts) {
+                    if (!rx_gap) {
+                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                            .opcode = @intFromEnum(Op.ack),
+                            .seq = seq,
+                            .win_start = win_start,
+                            .win_pkts = @intCast(win_pkts),
+                        });
+                        rx_acked = true;
+                        last_ack_tx = nowNs();
+                    } else {
+                        // Clean Go-Back-N recovery: 0 leftover descriptors, post fresh window and request resend.
+                        rx_got = 0;
+                        rx_gap = false;
+                        cts_gen +%= 1;
+                        rl.retrans_cnt += 1;
+                        rl.data_q.postDdpRx(recv_iova + win_off, win_pkts);
+                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                            .opcode = @intFromEnum(Op.nack),
+                            .seq = seq,
+                            .win_start = win_start,
+                            .win_pkts = 0,
+                            .cts_gen = cts_gen,
+                        });
+                        last_rx_activity = nowNs();
+                    }
+                }
+
+                const t = nowNs();
+                if (rx_acked and !tx_acked and (t - last_ack_tx) >= 2_000_000) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                        .opcode = @intFromEnum(Op.ack),
+                        .seq = seq,
+                        .win_start = win_start,
+                        .win_pkts = @intCast(win_pkts),
+                    });
+                    last_ack_tx = t;
+                }
+                // Re-send our CTS while peer hasn't delivered any packet for our RX window yet (independent of tx_allowed!).
+                if (!rx_acked and rx_skip == 0 and rx_got == 0 and (t - last_cts_tx) >= 1_000_000) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                        .opcode = @intFromEnum(Op.cts),
+                        .seq = seq,
+                        .win_start = win_start,
+                        .win_pkts = @intCast(win_pkts),
+                        .nbytes = nbytes,
+                        .cts_gen = cts_gen,
+                    });
+                    last_cts_tx = t;
+                }
+                // Partial RX window stalled (a packet dropped on the wire): post a fresh aligned window behind the
+                // `rem` leftover descriptors and ask peer to flush `rem` short frames then resend the window.
+                if (!rx_acked and (rx_skip > 0 or (rx_got > 0 and rx_got < win_pkts)) and !drained_any and (t - last_rx_activity) >= 5_000_000) {
+                    const rem: u32 = rx_skip + (win_pkts - rx_got);
+                    if (rl.data_q.rx_prod -% rl.data_q.rx_cons + win_pkts < uapi.ring_desc_cnt - 16) {
+                        rx_skip = rem;
+                        rx_got = 0;
+                        rx_gap = false;
+                        cts_gen +%= 1;
+                        rl.retrans_cnt += 1;
+                        rl.data_q.postDdpRx(recv_iova + win_off, win_pkts);
+                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                            .opcode = @intFromEnum(Op.nack),
+                            .seq = seq,
+                            .win_start = win_start,
+                            .win_pkts = @intCast(rem),
+                            .cts_gen = cts_gen,
+                        });
+                    }
+                    last_rx_activity = t;
+                }
+                if (t - t_win >= g.timeout_ns) {
+                    g.fail("port {d} DDP seq {d} win {d} timed out (rx={d}/{d} skip={d} ack_rx={} tx={d}/{d} ack_tx={})", .{ rl.port, seq, win_start, rx_got, win_pkts, rx_skip, rx_acked, tx_sent, win_pkts, tx_acked });
+                    return error.ProxyFailed;
+                }
+            }
+            win_start += win_pkts;
+            cts_gen +%= 1;
+        }
+        cacheInvalRange(recv_va, len);
+        g.signalFlag(rl, slot, seq);
+        rl.ddp_cnt += 1;
+    }
+
+    fn railWorker(g: *Gather, rail_idx: usize) void {
+        const rl = &g.rails[rail_idx];
+        if (rl.pin_cpu >= 0) pinCpu(rl.pin_cpu);
+        const c = g.ctrl();
+        var idle: u64 = 0;
+        while (g.running.load(.monotonic)) {
+            g.drainCtrlRx(rl);
+            const seq = @atomicLoad(u32, &c[c_seq], .acquire);
+            if (seq == rl.last_seq) {
+                idle += 1;
+                if (idle % 64 == 0) {
+                    rl.ctrl_q.reclaimTx();
+                    rl.data_q.reclaimTx();
+                }
+                if (idle >= idle_spins) nap.pause();
+                continue;
+            }
+            idle = 0;
+            var pending = seq -% rl.last_seq;
+            if (pending > slots) {
+                g.fail("port {d}: doorbell skipped {d} sequences (last {d}, now {d})", .{ rl.port, pending, rl.last_seq, seq });
+                @atomicStore(u32, &c[c_error], seq, .release);
+                g.failed.store(true, .release);
+                return;
+            }
+            var s = rl.last_seq +% 1;
+            while (pending > 0) : ({
+                s +%= 1;
+                pending -= 1;
+            }) {
+                const nbytes = @atomicLoad(u32, &c[c_nbytes + (s & 1)], .acquire);
+                if (nbytes == 0 or nbytes % 16 != 0 or nbytes > g.layout.slot_bytes) {
+                    g.fail("port {d}: bad shard size {d} at seq {d}", .{ rl.port, nbytes, s });
+                    @atomicStore(u32, &c[c_error], s, .release);
+                    g.failed.store(true, .release);
+                    return;
+                }
+                const st = stripeFor(nbytes, rail_idx, g.n_ports);
+                const res = if (st.len <= g.eager_max)
+                    g.runEager(rl, s, nbytes, st.off, st.len)
+                else
+                    g.runDdp(rl, s, nbytes, st.off, st.len);
+                res catch {
+                    @atomicStore(u32, &c[c_hca], rl.port, .release);
+                    @atomicStore(u32, &c[c_error], s, .release);
+                    g.failed.store(true, .release);
+                    return;
+                };
+                rl.last_seq = s;
+            }
+        }
+    }
+
+    pub fn fits(g: *const Gather, bytes: usize) bool {
+        return bytes > 0 and bytes <= g.max_bytes and bytes % 16 == 0;
+    }
+
+    /// Launches kernels.roce_gather on `stream` (CUDA-Graph capturable).
+    pub fn gather(g: *Gather, stream: abi.Stream, send: abi.DevicePtr, recv: abi.DevicePtr, bytes: usize) !void {
+        if (send % 16 != 0 or recv % 16 != 0) return error.Misaligned;
+        const packs = bytes / 16;
+        const need = @max(1, std.math.divCeil(usize, packs, 2 * threads) catch unreachable);
+        const grid: u32 = @intCast(@min(std.math.ceilPowerOfTwo(usize, need) catch max_blocks, max_blocks));
+        const klass: i32 = @intCast(std.math.log2_int(u32, grid));
+        const base: abi.DevicePtr = g.region.va;
+        var a: launch.Args = .{};
+        a.add(send);
+        a.add(recv);
+        a.add(@as(i32, @intCast(packs)));
+        a.add(@as(i32, g.rank));
+        a.add(base + g.layout.recv);
+        a.add(base + g.layout.flags);
+        a.add(base + g.layout.send);
+        a.add(base + g.layout.ctrl);
+        a.add(@as(i64, @intCast(g.layout.slot_bytes)));
+        a.add(g.counters.ptr);
+        a.add(klass);
+        a.add(spin_limit);
+        a.add(@as(i32, @intCast(g.n_ports)));
+        a.add(@as(i32, 2));
+        try launch.launch(g.f, .{ .grid = .{ .x = grid }, .block = .{ .x = threads } }, .{ .handle = stream, .d = g.d }, &a);
+        g.gathers += 1;
+    }
+
+    pub fn check(g: *Gather) !void {
+        const c = g.ctrl();
+        const bad = @atomicLoad(u32, &c[c_error], .acquire);
+        if (bad == 0 and !g.failed.load(.acquire)) return;
+        std.log.err("mgbe_zc all-gather failed (seq {d}, port {d}): {s}", .{ bad, c[c_hca], std.mem.sliceTo(&g.err, 0) });
+        return error.ProxyFailed;
+    }
+
+    pub fn abort(g: *Gather) void {
+        g.running.store(false, .release);
+    }
+
+    fn teardownRails(g: *Gather) void {
+        for (0..g.n_ports) |r| {
+            const rl = &g.rails[r];
+            rl.data_q.teardown(g.fd);
+            rl.ctrl_q.teardown(g.fd);
+            if (rl.pool_mr_id != 0 and g.fd >= 0) {
+                _ = std.os.linux.ioctl(g.fd, uapi.ioc_dereg_mr, @intFromPtr(&rl.pool_mr_id));
+                rl.pool_mr_id = 0;
+            }
+            if (rl.pool_va) |p| {
+                munmapPtr(p, port_pool_bytes);
+                rl.pool_va = null;
+            }
+        }
+    }
+
+    fn teardown(g: *Gather) void {
+        if (g.running.swap(false, .acq_rel)) {
+            for (0..g.n_ports) |r| {
+                if (g.rails[r].thread) |t| t.join();
+                g.rails[r].thread = null;
+            }
+        }
+        if (g.debug and g.gathers > 0) {
+            std.log.info("mgbe_zc rank {d}: {d} gathers (rail0 eager={d} ddp={d} retrans={d})", .{
+                g.rank, g.gathers, g.rails[0].eager_cnt, g.rails[0].ddp_cnt, g.rails[0].retrans_cnt,
+            });
+        }
+        g.teardownRails();
+        g.module.unload();
+        g.counters.free();
+        if (g.region_mr_id != 0 and g.fd >= 0) {
+            _ = std.os.linux.ioctl(g.fd, uapi.ioc_dereg_mr, @intFromPtr(&g.region_mr_id));
+            g.region_mr_id = 0;
+        }
+        g.region.free();
+        if (g.fd >= 0) {
+            _ = std.os.linux.close(g.fd);
+            g.fd = -1;
+        }
+    }
+
+    pub fn deinit(g: *Gather) void {
+        g.teardown();
+        g.gpa.destroy(g);
+    }
+};
+
+test "mgbe_zc layout and striping cover every byte without overlap" {
+    const l = Layout.of(16 << 20);
+    try std.testing.expectEqual(@as(usize, 0), l.recv);
+    try std.testing.expectEqual(@as(usize, 32 << 20), l.flags);
+    try std.testing.expectEqual(l.flags + 2 * 4 * 128, l.send);
+    try std.testing.expectEqual(l.send + (32 << 20), l.ctrl);
+    for ([_]usize{ 16, 48, 64, 4096, 32768, 131072, (16 << 20) - 16, 16 << 20 }) |nb| {
+        var total: usize = 0;
+        for (0..4) |r| {
+            const st = stripeFor(nb, r, 4);
+            try std.testing.expectEqual(total, st.off);
+            try std.testing.expectEqual(@as(usize, 0), st.len % 16);
+            total += st.len;
+        }
+        try std.testing.expectEqual(nb, total);
+    }
+}
