@@ -0,0 +1,111 @@
+//! Userspace ABI for /dev/mgbe_zc (Tegra264 zero-copy 4x25GbE MGBE driver), matching mgbe_zc_uapi.h.
+const std = @import("std");
+
+pub const dev_path: [:0]const u8 = "/dev/mgbe_zc";
+
+pub const max_ports: usize = 4;
+pub const queues_per_port: usize = 2; // qidx 0: VDMA 2 (ctrl/eager), qidx 1: VDMA 3 (DDP data)
+pub const ring_desc_cnt: u32 = 4096;
+pub const ring_mask: u32 = ring_desc_cnt - 1;
+pub const ring_bytes: usize = @as(usize, ring_desc_cnt) * 16; // 64 KiB
+pub const reg_map_bytes: usize = 4096;
+
+pub const ethtype_ctrl: u16 = 0x88B5; // FRP entry 0 -> VDMA 2 (qidx 0)
+pub const ethtype_data: u16 = 0x88B6; // FRP entry 1 -> VDMA 3 (qidx 1)
+
+pub const ch_tdtlp: usize = 0x24; // TX tail pointer doorbell
+pub const ch_rdtlp: usize = 0x2C; // RX tail pointer doorbell
+
+pub const desc_own: u32 = 1 << 31;
+pub const desc_ctxt: u32 = 1 << 30;
+pub const desc_fd: u32 = 1 << 29;
+pub const desc_ld: u32 = 1 << 28;
+
+pub const rdes3_es_mgbe: u32 = 1 << 15;
+pub const rdes3_pl_mask: u32 = 0x00003FFF;
+
+pub const tdes2_b1l_mask: u32 = 0x00003FFF;
+pub const tdes3_fl_mask: u32 = 0x00007FFF;
+
+pub const HwDesc = extern struct {
+    d0: u32,
+    d1: u32,
+    d2: u32,
+    d3: u32,
+};
+
+pub const PortInfo = extern struct {
+    port: u32 = 0,
+    present: u32 = 0,
+    ifname: [16]u8 = @splat(0),
+    mac: [6]u8 = @splat(0),
+    pad0: [2]u8 = @splat(0),
+    link_up: u32 = 0,
+    mtu: u32 = 0,
+    sph_supported: u32 = 0,
+    hw_chan: [queues_per_port]u32 = @splat(0),
+    pdma_chan: [queues_per_port]u32 = @splat(0),
+    reg_page_off: u32 = 0,
+    ring_desc_cnt: u32 = 0,
+};
+
+pub const QueueAlloc = extern struct {
+    port: u32 = 0,
+    qidx: u32 = 0,
+    tx_ring_iova: u64 = 0,
+    rx_ring_iova: u64 = 0,
+    mmap_tx_off: u64 = 0,
+    mmap_rx_off: u64 = 0,
+    mmap_reg_off: u64 = 0,
+    ch_reg_off: u32 = 0,
+    hw_chan: u32 = 0,
+};
+
+pub const QueueStart = extern struct {
+    port: u32 = 0,
+    qidx: u32 = 0,
+    rx_buf_size: u32 = 0,
+    sph_enable: u32 = 0,
+    sph_split_bytes: u32 = 0,
+    init_rx_tail_idx: u32 = 0,
+    cur_tx_desc_lo: u32 = 0,
+    cur_rx_desc_lo: u32 = 0,
+};
+
+pub const QueueStop = extern struct {
+    port: u32 = 0,
+    qidx: u32 = 0,
+};
+
+pub const MrReq = extern struct {
+    va: u64 = 0,
+    len: u64 = 0,
+    dmabuf_fd: i32 = -1,
+    flags: u32 = 0,
+    mr_id: u32 = 0,
+    nents: [max_ports]u32 = @splat(0),
+    iova: [max_ports]u64 = @splat(0),
+    first_seg_len: [max_ports]u64 = @splat(0),
+};
+
+fn iowr(comptime nr: u8, comptime T: type) u32 {
+    return (@as(u32, 3) << 30) | (@as(u32, @sizeOf(T)) << 16) | (@as(u32, 'Z') << 8) | @as(u32, nr);
+}
+
+pub const ioc_port_info: u32 = iowr(1, PortInfo);
+pub const ioc_queue_alloc: u32 = iowr(2, QueueAlloc);
+pub const ioc_queue_start: u32 = iowr(3, QueueStart);
+pub const ioc_queue_stop: u32 = iowr(4, QueueStop);
+pub const ioc_reg_mr: u32 = iowr(5, MrReq);
+pub const ioc_dereg_mr: u32 = iowr(6, u32);
+pub const ioc_port_reinit: u32 = iowr(7, u32);
+
+comptime {
+    std.debug.assert(@sizeOf(HwDesc) == 16);
+    std.debug.assert(@sizeOf(PortInfo) == 68);
+    std.debug.assert(@sizeOf(QueueAlloc) == 56);
+    std.debug.assert(@sizeOf(QueueStart) == 32);
+    std.debug.assert(@sizeOf(QueueStop) == 8);
+    std.debug.assert(@sizeOf(MrReq) == 112);
+    std.debug.assert(@offsetOf(MrReq, "iova") == 48);
+}
