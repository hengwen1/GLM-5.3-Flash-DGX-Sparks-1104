+__device__ __forceinline__ void tc5_cvt_fp8x4_to_bf16x4(uint32_t raw, float rscale, __nv_bfloat162& b0,
+                                                        __nv_bfloat162& b1) {
+  const float2 f0 = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2((uint16_t)(raw & 0xFFFFu), __NV_E4M3)));
+  const float2 f1 = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2((uint16_t)(raw >> 16), __NV_E4M3)));
+  b0 = __floats2bfloat162_rn(__fmul_rn(f0.x, rscale), __fmul_rn(f0.y, rscale));
+  b1 = __floats2bfloat162_rn(__fmul_rn(f1.x, rscale), __fmul_rn(f1.y, rscale));
+}
