+// sm_110a 5th-gen tensor core MLA chunk attention (HB=32, KT=128, M=128, N=32, 128 TMEM cols, 193536 B dynamic smem).
+// Uses 1-warp-per-key coalesced 16B loads (hoisted tok/pt/scale) and 8-warp parallel softmax over all 32 heads.
+template <bool FP8, bool PAGED8>
+__device__ void chunks_32_tcgen05(const __nv_bfloat16* qa, const __nv_bfloat16* lc, const int* pos, const int* tok,
+                                  const int* cnt, float* po, float* pm, float* pl, int64_t rows, int64_t heads,
+                                  int64_t w, float scale, int sparse, const int* pt, int64_t pstep,
+                                  const float* scales) {
+  constexpr int HB = 32, KTC = 128, S_STRIDE = 132;
+  extern __shared__ __align__(16) unsigned char smem[];
+  __nv_bfloat16* sQ = reinterpret_cast<__nv_bfloat16*>(smem);
+  __nv_bfloat16* sKV = sQ + 8 * HB * 64;
+  __nv_bfloat16* sP = sKV + 8 * KTC * 64;
+  float* sS = reinterpret_cast<float*>(sP + 2 * HB * 64);
+  float* s_m = sS + HB * S_STRIDE;
+  float* s_l = s_m + HB;
+  float* s_alp = s_l + HB;
+  uint64_t* mbar = reinterpret_cast<uint64_t*>(s_alp + HB);
+  uint32_t* taddr_sh = reinterpret_cast<uint32_t*>(mbar + 2);
+
+  const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+  const int64_t r = blockIdx.x, h0 = (int64_t)blockIdx.y * HB, c = blockIdx.z;
+  const int64_t n = sparse ? cnt[r] : 0, limit = sparse ? 0 : (int64_t)pos[0] + r;
+  const int64_t start = c * CH;
+  const bool live = sparse ? (start < n) : (start <= limit);
+
+  if (!live) {
+    for (int idx = t; idx < HB * LW; idx += 256) {
+      const int hd = idx / LW, d = idx % LW;
+      if (h0 + hd < heads) po[((c * rows + r) * heads + (h0 + hd)) * LW + d] = 0.0f;
+    }
+    if (t < HB && h0 + t < heads) {
+      const int64_t base = (c * rows + r) * heads + (h0 + t);
+      pm[base] = -INFINITY;
+      pl[base] = 0.0f;
+    }
+    return;
+  }
+
+  if (t == 0) {
+    tc5_mbar_init(&mbar[0], 1);
+    tc5_mbar_init(&mbar[1], 1);
+  }
+  if (t < HB) {
+    s_m[t] = -INFINITY;
+    s_l[t] = 0.0f;
+  }
+  if (warp == 0) {
+    const uint32_t sh = (uint32_t)__cvta_generic_to_shared(taddr_sh);
+    asm volatile("tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%0], 128;" ::"r"(sh));
+  }
+
+  // Load Q [32 x 512] into 8 SW128 slabs of [32 x 64]
+  for (int idx = t; idx < HB * (LW / 8); idx += 256) {
+    const int hd = idx >> 6, u = idx & 63, slab = u >> 3, u8 = u & 7;
+    const int su = u8 ^ (hd & 7);
+    uint4 v = make_uint4(0, 0, 0, 0);
+    if (h0 + hd < heads) v = __ldg(reinterpret_cast<const uint4*>(qa + (r * heads + h0 + hd) * LW + u * 8));
+    *reinterpret_cast<uint4*>(sQ + slab * (HB * 64) + hd * 64 + su * 8) = v;
+  }
+
+  const __nv_bfloat16* keys_at = (!FP8 && pt && !sparse) ? lc + ((int64_t)pt[c] * (pstep / 2) - start * LW) : lc;
+  const unsigned char* codes8 = reinterpret_cast<const unsigned char*>(lc);
+  const float* scales8 = scales;
+  if constexpr (PAGED8) {
+    if (!sparse) {
+      const int64_t page = (int64_t)pt[c] * pstep;
+      codes8 += page - start * LW;
+      scales8 = reinterpret_cast<const float*>(reinterpret_cast<const unsigned char*>(scales) + page) - start;
+    }
+  }
+
+  __syncthreads();
+  const uint32_t taddr = *taddr_sh;
+  const uint32_t baseQ = (uint32_t)__cvta_generic_to_shared(sQ);
+  const uint32_t baseKV = (uint32_t)__cvta_generic_to_shared(sKV);
+  const uint32_t baseP = (uint32_t)__cvta_generic_to_shared(sP);
+
+  const int w_grp = warp >> 2, w_in = warp & 3;
+  float o_acc[2][HB];
+#pragma unroll
+  for (int mt = 0; mt < 2; ++mt)
+#pragma unroll
+    for (int h = 0; h < HB; ++h) o_acc[mt][h] = 0.0f;
+
+  uint32_t phase0 = 0, phase1 = 0;
+  const int slab_l = lane >> 2, pair_l = (lane & 3) * 2;
+
+  for (int tile = 0; tile < CH / KTC; ++tile) {
+    const int64_t first = start + tile * KTC;
+
+    // 1. Load 128 keys (16 keys/warp, 1 warp/key, coalesced 16B loads with hoisted metadata)
+    for (int ki_w = 0; ki_w < 16; ++ki_w) {
+      const int key = warp * 16 + ki_w;
+      const int64_t ki = first + key;
+      const bool ok = sparse ? (ki < n) : (ki <= limit);
+      uint4 out0 = make_uint4(0, 0, 0, 0), out1 = make_uint4(0, 0, 0, 0);
+      if (ok) {
+        if constexpr (FP8) {
+          int64_t page = 0, crow = 0;
+          float rscale = 1.0f;
+          if (lane == 0) {
+            const int64_t src = sparse ? (int64_t)tok[r * w + ki] : ki;
+            if constexpr (PAGED8) {
+              if (sparse) {
+                const int s = (int)src;
+                page = (int64_t)pt[s >> 9] * pstep;
+                crow = s & (CH - 1);
+                rscale = *reinterpret_cast<const float*>(reinterpret_cast<const unsigned char*>(scales) + page +
+                                                         crow * 4);
+              } else {
+                crow = src;
+                rscale = scales8[src];
+              }
+            } else {
+              crow = src;
+              rscale = scales8[src];
+            }
+          }
+          page = __shfl_sync(0xffffffffu, page, 0);
+          crow = __shfl_sync(0xffffffffu, crow, 0);
+          rscale = __shfl_sync(0xffffffffu, rscale, 0);
+          const uint4 raw = __ldg(reinterpret_cast<const uint4*>(codes8 + page + crow * LW + lane * 16));
+          __nv_bfloat162 b0[4], b1[4];
+          tc5_cvt_fp8x4_to_bf16x4(raw.x, rscale, b0[0], b0[1]);
+          tc5_cvt_fp8x4_to_bf16x4(raw.y, rscale, b0[2], b0[3]);
+          tc5_cvt_fp8x4_to_bf16x4(raw.z, rscale, b1[0], b1[1]);
+          tc5_cvt_fp8x4_to_bf16x4(raw.w, rscale, b1[2], b1[3]);
+          out0 = *reinterpret_cast<uint4*>(b0);
+          out1 = *reinterpret_cast<uint4*>(b1);
+        } else {
+          int64_t src = 0;
+          if (lane == 0) src = sparse ? (int64_t)tok[r * w + ki] : ki;
+          src = __shfl_sync(0xffffffffu, src, 0);
+          const __nv_bfloat16* kp = keys_at + src * LW + lane * 16;
+          out0 = __ldg(reinterpret_cast<const uint4*>(kp));
+          out1 = __ldg(reinterpret_cast<const uint4*>(kp + 8));
+        }
+      }
+      const int su0 = pair_l ^ (key & 7), su1 = (pair_l + 1) ^ (key & 7);
+      __nv_bfloat16* dst = sKV + slab_l * (KTC * 64) + key * 64;
+      *reinterpret_cast<uint4*>(dst + su0 * 8) = out0;
+      *reinterpret_cast<uint4*>(dst + su1 * 8) = out1;
+    }
+    __syncthreads();
+
+    // 2. QK^T: K [128 x 512] @ Q^T [512 x 32] -> S^T [128 x 32] in TMEM [0..32)
+    if (t == 0) {
+      constexpr uint32_t idesc_qk = tc5_idesc_bf16(128, 32, false);
+#pragma unroll
+      for (int slab = 0; slab < 8; ++slab) {
+        const uint32_t a_slab = baseKV + slab * 16384;
+        const uint32_t b_slab = baseQ + slab * 4096;
+#pragma unroll
+        for (int k16 = 0; k16 < 64; k16 += 16) {
+          const uint64_t da = tc5_smem_desc_sw128(a_slab + k16 * 2, 16, 1024);
+          const uint64_t db = tc5_smem_desc_sw128(b_slab + k16 * 2, 16, 1024);
+          tc5_mma_one(taddr, da, db, idesc_qk, (slab > 0) || (k16 > 0));
+        }
+      }
+      tc5_commit(&mbar[0]);
+    }
+    tc5_mbar_wait(&mbar[0], phase0);
+    phase0 ^= 1;
+    asm volatile("tcgen05.fence::after_thread_sync;" ::: "memory");
+
+    // 3a. Warps 0..3 read S^T [128 x 32] from TMEM into sS[32][132]
+    if (warp < 4) {
+      const int key = warp * 32 + lane;
+      const int64_t ki = first + key;
+      const bool key_ok = sparse ? (ki < n) : (ki <= limit);
+      uint32_t r0[16];
+      tc5_ld32x32_x16(taddr + ((uint32_t)(warp * 32) << 16) + 0, r0);
+#pragma unroll
+      for (int h = 0; h < 16; ++h) sS[h * S_STRIDE + key] = key_ok ? __fmul_rn(__uint_as_float(r0[h]), scale) : -INFINITY;
+      tc5_ld32x32_x16(taddr + ((uint32_t)(warp * 32) << 16) + 16, r0);
+#pragma unroll
+      for (int h = 0; h < 16; ++h)
+        sS[(16 + h) * S_STRIDE + key] = key_ok ? __fmul_rn(__uint_as_float(r0[h]), scale) : -INFINITY;
+    }
+    __syncthreads();
+
+    // 3b. All 8 warps compute online softmax in parallel (4 heads/warp, 4 keys/lane)
+    {
+      const int p_slab = lane >> 4, u8 = (lane & 15) >> 1, half4 = (lane & 1) * 4;
+#pragma unroll
+      for (int hi = 0; hi < 4; ++hi) {
+        const int h = warp * 4 + hi;
+        const float4 sv = *reinterpret_cast<const float4*>(sS + h * S_STRIDE + lane * 4);
+        float mx = fmaxf(fmaxf(sv.x, sv.y), fmaxf(sv.z, sv.w));
+        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 16));
+        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 8));
+        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 4));
+        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 2));
+        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, 1));
+
+        const float old_m = s_m[h];
+        const bool active = (mx != -INFINITY);
+        const float nm = active ? fmaxf(old_m, mx) : old_m;
+        const float alp = active ? (old_m == -INFINITY ? 0.0f : glm_triton::exp_approx(old_m - nm)) : 1.0f;
+
+        const float p0 = (active && sv.x != -INFINITY) ? glm_triton::exp_approx(sv.x - nm) : 0.0f;
+        const float p1 = (active && sv.y != -INFINITY) ? glm_triton::exp_approx(sv.y - nm) : 0.0f;
+        const float p2 = (active && sv.z != -INFINITY) ? glm_triton::exp_approx(sv.z - nm) : 0.0f;
+        const float p3 = (active && sv.w != -INFINITY) ? glm_triton::exp_approx(sv.w - nm) : 0.0f;
+
+        const int su = u8 ^ (h & 7);
+        __nv_bfloat162 pb[2];
+        pb[0] = __floats2bfloat162_rn(p0, p1);
+        pb[1] = __floats2bfloat162_rn(p2, p3);
+        *reinterpret_cast<uint2*>(sP + p_slab * (HB * 64) + h * 64 + su * 8 + half4) = *reinterpret_cast<uint2*>(pb);
+
+        float sm = (p0 + p1) + (p2 + p3);
+        sm += __shfl_xor_sync(0xffffffffu, sm, 16);
+        sm += __shfl_xor_sync(0xffffffffu, sm, 8);
+        sm += __shfl_xor_sync(0xffffffffu, sm, 4);
+        sm += __shfl_xor_sync(0xffffffffu, sm, 2);
+        sm += __shfl_xor_sync(0xffffffffu, sm, 1);
+
+        if (lane == 0) {
+          s_m[h] = nm;
+          s_alp[h] = alp;
+          s_l[h] = __fmaf_rn(s_l[h], alp, sm);
+        }
+      }
+    }
+    __syncthreads();
+
+    // 4. PV: V^T [512 x 128] @ P^T [128 x 32] -> dO^T [512 x 32] in TMEM [0..128)
+    if (t == 0) {
+      constexpr uint32_t idesc_pv = tc5_idesc_bf16(128, 32, true);
+#pragma unroll
+      for (int mt = 0; mt < 4; ++mt) {
+        const uint32_t a_base = baseKV + (2 * mt) * 16384;
+        const uint32_t t_col = taddr + mt * 32;
+#pragma unroll
+        for (int k = 0; k < 128; k += 16) {
+          const int p_slab = k >> 6, k_in = k & 63;
+          const uint64_t da = tc5_smem_desc_sw128(a_base + k * 128, 16384, 1024);
+          const uint64_t db = tc5_smem_desc_sw128(baseP + p_slab * 4096 + k_in * 2, 16, 1024);
+          tc5_mma_one(t_col, da, db, idesc_pv, k > 0);
+        }
+      }
+      tc5_commit(&mbar[1]);
+    }
+
+#pragma unroll
+    for (int mt = 0; mt < 2; ++mt)
+#pragma unroll
+      for (int h = 0; h < HB; ++h) o_acc[mt][h] = __fmul_rn(o_acc[mt][h], s_alp[h]);
+
+    tc5_mbar_wait(&mbar[1], phase1);
+    phase1 ^= 1;
+    asm volatile("tcgen05.fence::after_thread_sync;" ::: "memory");
+
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int mt = w_grp * 2 + i;
+      uint32_t r0[16];
+      tc5_ld32x32_x16(taddr + ((uint32_t)(w_in * 32) << 16) + mt * 32 + 0, r0);
+#pragma unroll
+      for (int h = 0; h < 16; ++h) o_acc[i][h] += __uint_as_float(r0[h]);
+      tc5_ld32x32_x16(taddr + ((uint32_t)(w_in * 32) << 16) + mt * 32 + 16, r0);
+#pragma unroll
+      for (int h = 0; h < 16; ++h) o_acc[i][16 + h] += __uint_as_float(r0[h]);
+    }
+    __syncthreads();
+  }
+
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    const int d = (w_grp * 2 + i) * 128 + w_in * 32 + lane;
+#pragma unroll
+    for (int h = 0; h < HB; ++h) {
+      if (h0 + h < heads) po[((c * rows + r) * heads + (h0 + h)) * LW + d] = o_acc[i][h];
+    }
+  }
+  if (t < HB && h0 + t < heads) {
+    const int64_t base = (c * rows + r) * heads + (h0 + t);
+    pm[base] = s_m[t];
+    pl[base] = s_l[t];
+  }
+
+  __syncthreads();
+  if (warp == 0) {
+    asm volatile("tcgen05.dealloc.cta_group::1.sync.aligned.b32 %0, 128;" ::"r"(taddr));
+    asm volatile("tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;");
+  }
+}
+#endif
